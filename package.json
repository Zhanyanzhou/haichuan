{
  "name": "jewelry-platform",
  "version": "1.0.0",
  "private": true,
  "description": "海川珠宝全栈网站与管理平台",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run build:server && concurrently \"npm run dev:server:run\" \"npm run dev:client\"",
    "dev:server": "npm run build:server && npm run dev:server:run",
    "dev:server:run": "cd server && node --env-file=.env scripts/start-local.cjs",
    "dev:client": "cd client && npm run dev -- --mode development",
    "dev:mock": "cd client && npm run dev -- --mode mock",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "lint": "cd client && npm run lint",
    "typecheck": "npm run contracts:check && npm run typecheck:server && npm run typecheck:client",
    "typecheck:server": "cd server && npx tsc --noEmit -p tsconfig.json",
    "typecheck:client": "cd client && npx tsc --noEmit -p tsconfig.json",
    "contracts:generate": "node scripts/generate-content-template-contract.mjs && node scripts/generate-template-definition-contract.mjs",
    "contracts:check": "node scripts/generate-content-template-contract.mjs --check && node scripts/generate-template-definition-contract.mjs --check",
    "dynamic-templates:generate": "node scripts/generate-template-definition-contract.mjs",
    "dynamic-templates:check": "node scripts/generate-template-definition-contract.mjs --check",
    "verify:template-acceptance": "node scripts/verify-template-acceptance-evidence.mjs",
    "audit:template-v2-gate-a": "node scripts/audit-template-v2-gate-a-readiness.mjs",
    "audit:template-v2-gate-b:readonly": "cd server && npm run audit:template-v2-gate-b:readonly",
    "audit:template-v2-gate-d:static": "node scripts/audit-template-v2-gate-d-readiness.mjs",
    "test": "npm run test:contracts && npm run test:content-templates && npm run test:server && npm run test:public-assets && npm run test:runtime-ownership && npm run test:release-supply-chain && npm run test:admin-ui-standards",
    "test:admin-ui-standards": "node scripts/verify-admin-ui-standards.mjs",
    "test:contracts": "node scripts/verify-page-builder-contract.mjs && node scripts/verify-wechat-callback-origin.mjs && node scripts/verify-inquiry-privacy-consent.mjs",
    "test:server": "cd server && npm test",
    "test:content-templates": "npm run contracts:check && node scripts/verify-content-template-contract.mjs && node scripts/verify-content-template-skeletons.mjs && node scripts/verify-content-template-image-specs.mjs && node scripts/verify-inspector-schema.mjs",
    "test:page-builder-publish": "node scripts/verify-page-builder-publish.mjs",
    "test:selection-inquiry": "node scripts/verify-selection-inquiry-security.mjs && node scripts/verify-selection-inquiry-validation.mjs",
    "test:trade": "npm run test:trade-state && npm run test:trade-concurrency && npm run test:trade-contract",
    "test:trade-state": "node scripts/verify-trade-state-machine.mjs",
    "test:trade-concurrency": "node scripts/verify-trade-concurrency.mjs",
    "test:trade-contract": "node scripts/verify-trade-contract.mjs",
    "verify:environment-contract": "node scripts/verify-environment-contract.mjs",
    "verify:wechat-pay-certificate-files": "node scripts/verify-environment-contract.mjs --wechat-pay-host-files",
    "verify:migration-integrity": "node scripts/verify-migration-integrity.mjs",
    "verify:release-images": "node scripts/verify-release-images.mjs --static",
    "test:release-supply-chain": "node --test scripts/release-profile-contract.spec.mjs scripts/verify-migration-integrity.spec.mjs scripts/verify-release-images.spec.mjs scripts/verify-production-evidence.spec.mjs",
    "verify:production-evidence": "node scripts/verify-production-evidence.mjs",
    "audit:public-assets": "node scripts/audit-public-assets.mjs",
    "verify:public-asset-audit": "node scripts/audit-public-assets.mjs --check artifacts/public-asset-audit/current.json",
    "audit:runtime-ownership": "node scripts/audit-runtime-ownership.mjs",
    "verify:runtime-ownership-audit": "node scripts/audit-runtime-ownership.mjs --check artifacts/runtime-ownership-audit/current.json",
    "test:runtime-ownership": "node scripts/audit-runtime-ownership.mjs --verify",
    "generate:candidate-evidence": "node scripts/generate-candidate-evidence.mjs",
    "verify:candidate-evidence": "node scripts/generate-candidate-evidence.mjs --check artifacts/candidate-evidence/current.json",
    "verify:client-bundle": "node scripts/verify-client-bundle-budget.mjs",
    "db:migrate": "cd server && npx prisma migrate dev",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prepare": "husky",
    "test:public-assets": "node scripts/verify-public-assets.mjs && node scripts/audit-public-assets.mjs --verify",
    "test:ui-colors": "node scripts/verify-ui-color-standards.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "js-yaml": "4.3.1"
  }
}
