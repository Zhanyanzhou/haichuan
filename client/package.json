{
  "name": "jewelry-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "珠宝管理平台 - React 前端",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "preinstall": "node ../scripts/verify-node-version.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "test:public-env": "node --test vite-public-env.spec.mjs",
    "test:image-quality": "node --experimental-strip-types --test responsiveUploadsImage.spec.ts imageDeliveryGeometry.spec.ts trustedMediaSize.spec.ts tests/media-picker-image-quality.unit.mjs",
    "test:storybook:state": "playwright test --config playwright.storybook.config.ts --grep @state",
    "test:visual": "playwright test --config playwright.storybook.config.ts --grep @visual --update-snapshots=none",
    "test:visual:candidate": "node ../scripts/create-storybook-visual-candidates.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test public-accessibility.spec.ts --project=public-chromium",
    "storybook": "storybook dev",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@puckeditor/core": "^0.22.4",
    "antd": "^5.13.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.10",
    "framer-motion": "^10.18.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.33",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "happy-dom": "21.0.4",
    "minimatch": "11.0.4",
    "postcss-selector-parser": "6.1.5",
    "source-map-js": "1.2.2"
  }
}
