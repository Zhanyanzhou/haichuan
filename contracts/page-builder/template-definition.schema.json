{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haichuan.local/contracts/page-builder/template-definition.schema.json",
  "title": "Haichuan Unified Template Contract",
  "description": "统一母模板定义与页面实例的机器合同；真实业务内容仍由页面实例引用业务来源。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "name",
    "metadata",
    "rootNodeId",
    "nodes",
    "slots",
    "defaultContent"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "templateRecipe": {
      "$ref": "#/$defs/templateRecipe"
    },
    "templateId": {
      "$ref": "#/$defs/stableId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "rootNodeId": {
      "$ref": "#/$defs/stableId"
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 500,
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "slots": {
      "type": "object",
      "maxProperties": 250,
      "propertyNames": {
        "$ref": "#/$defs/stableId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "defaultContent": {
      "description": "schema1 保留历史默认内容，schema2 必须为空；schema3 保存按槽位编辑的默认内容，页面实例内容仍单独保存。",
      "type": "object",
      "maxProperties": 250
    },
    "previewContent": {
      "description": "仅兼容既有模板定义中的历史预览数据；当前模板目录和设计画布使用系统派生占位，新建母模板必须保持为空。",
      "type": "object",
      "maxProperties": 250
    }
  },
  "x-currentSchemaVersion": 3,
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "metadata": {
            "properties": {
              "previewTabletWidth": false
            }
          },
          "nodes": {
            "additionalProperties": {
              "properties": {
                "responsive": {
                  "properties": {
                    "tablet": false,
                    "desktop": {
                      "$ref": "#/$defs/legacyResponsiveRules"
                    },
                    "mobile": {
                      "$ref": "#/$defs/legacyResponsiveRules"
                    }
                  }
                }
              }
            }
          },
          "slots": {
            "additionalProperties": {
              "properties": {
                "tabletRules": false,
                "desktopRules": {
                  "$ref": "#/$defs/legacySlotRules"
                },
                "mobileRules": {
                  "$ref": "#/$defs/legacySlotRules"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "metadata": {
            "properties": {
              "mobileBreakpoint": {
                "const": 767
              }
            }
          },
          "previewContent": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "templateRecipe": false,
          "nodes": {
            "additionalProperties": {
              "properties": {
                "responsive": {
                  "additionalProperties": {
                    "properties": {
                      "backgroundColor": false,
                      "backgroundImage": false,
                      "backgroundGradient": false,
                      "opacity": false
                    }
                  }
                }
              }
            }
          },
          "slots": {
            "additionalProperties": {
              "properties": {
                "semanticRole": false,
                "desktopRules": {
                  "properties": {
                    "fontFamily": false,
                    "color": false,
                    "letterSpacing": false
                  }
                },
                "tabletRules": {
                  "properties": {
                    "fontFamily": false,
                    "color": false,
                    "letterSpacing": false
                  }
                },
                "mobileRules": {
                  "properties": {
                    "fontFamily": false,
                    "color": false,
                    "letterSpacing": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "defaultContent": {
            "maxProperties": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "templateRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipeVersion",
        "presetVersion",
        "purpose",
        "canvas",
        "layout",
        "media",
        "content",
        "style",
        "rules"
      ],
      "properties": {
        "recipeVersion": {
          "const": 1
        },
        "presetVersion": {
          "enum": [
            1,
            2
          ]
        },
        "purpose": {
          "enum": [
            "productPromotion",
            "newProduct",
            "event",
            "brand",
            "social",
            "news",
            "profile",
            "general",
            "custom"
          ]
        },
        "customPurpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height",
            "aspectRatio"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "aspectRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4096
            }
          }
        },
        "layout": {
          "enum": [
            "topImageBottomContent",
            "topContentBottomImage",
            "leftImageRightContent",
            "leftContentRightImage",
            "fullImageOverlay",
            "centerSubject",
            "headerSubjectFooter",
            "splitColumns",
            "cards",
            "free"
          ]
        },
        "media": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "name",
              "aspectRatio",
              "fitMode",
              "borderRadius",
              "replaceable",
              "allowCrop"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
              },
              "role": {
                "enum": [
                  "heroImage",
                  "logo",
                  "backgroundImage",
                  "secondaryImage",
                  "custom"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "aspectRatio": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 4096
              },
              "fitMode": {
                "enum": [
                  "cover",
                  "contain",
                  "fill"
                ]
              },
              "borderRadius": {
                "type": "number",
                "minimum": 0,
                "maximum": 256
              },
              "replaceable": {
                "type": "boolean"
              },
              "allowCrop": {
                "type": "boolean"
              },
              "defaultImage": {
                "type": "string",
                "maxLength": 2048
              },
              "shape": {
                "enum": [
                  "rectangle",
                  "circle"
                ]
              },
              "freeRatio": {
                "type": "boolean"
              }
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "name",
              "defaultContent",
              "maxLength",
              "editable"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
              },
              "role": {
                "enum": [
                  "title",
                  "subtitle",
                  "description",
                  "brandName",
                  "tag",
                  "date",
                  "price",
                  "originalPrice",
                  "offer",
                  "cta",
                  "contact",
                  "customText",
                  "time",
                  "location",
                  "productName",
                  "sellingPoint",
                  "discount",
                  "personName",
                  "position",
                  "biography",
                  "socialInfo"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "defaultContent": {
                "type": "string",
                "maxLength": 10000
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "editable": {
                "type": "boolean"
              }
            }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "variant",
            "background",
            "primaryColor",
            "backgroundColor",
            "textColor",
            "radius",
            "spacing"
          ],
          "properties": {
            "variant": {
              "enum": [
                "minimal",
                "business",
                "premium",
                "vibrant",
                "tech",
                "warm",
                "custom",
                "ultraMinimal"
              ]
            },
            "background": {
              "enum": [
                "light",
                "dark",
                "brand",
                "custom",
                "softLight"
              ]
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#(?:[A-Fa-f0-9]{3}|[A-Fa-f0-9]{6})$"
            },
            "backgroundColor": {
              "type": "string",
              "pattern": "^#(?:[A-Fa-f0-9]{3}|[A-Fa-f0-9]{6})$"
            },
            "textColor": {
              "type": "string",
              "pattern": "^#(?:[A-Fa-f0-9]{3}|[A-Fa-f0-9]{6})$"
            },
            "radius": {
              "enum": [
                "none",
                "small",
                "medium",
                "large",
                "extraLarge"
              ]
            },
            "spacing": {
              "enum": [
                "compact",
                "standard",
                "relaxed",
                "extraRelaxed"
              ]
            },
            "margin": {
              "enum": [
                "compact",
                "standard",
                "relaxed"
              ]
            },
            "alignment": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "secondaryTextColor": {
              "type": "string",
              "pattern": "^#(?:[A-Fa-f0-9]{3}|[A-Fa-f0-9]{6})$"
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aspectLocked"
          ],
          "properties": {
            "aspectLocked": {
              "type": "boolean"
            },
            "mediaArrangement": {
              "description": "图片区排列方向；省略或 auto 保留历史自动排布，row/column 固定主轴，不随单张图片比例改变。",
              "enum": ["auto", "row", "column"]
            }
          }
        }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "purpose",
        "layoutType",
        "slotSummary",
        "recommendedFor",
        "desktopRatio",
        "mobileRatio",
        "tags"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "layoutType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "slotSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "recommendedFor": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "desktopRatio": {
          "$ref": "#/$defs/ratioLabel"
        },
        "mobileRatio": {
          "$ref": "#/$defs/ratioLabel"
        },
        "canvasSize": {
          "$ref": "#/$defs/canvasSize"
        },
        "previewDesktopWidth": {
          "type": "integer",
          "minimum": 768,
          "maximum": 2560
        },
        "previewMobileWidth": {
          "type": "integer",
          "minimum": 280,
          "maximum": 767
        },
        "previewTabletWidth": {
          "type": "integer",
          "minimum": 768,
          "maximum": 1023
        },
        "mobileBreakpoint": {
          "type": "integer",
          "minimum": 480,
          "maximum": 1024
        },
        "minViewportWidth": {
          "type": "integer",
          "minimum": 280,
          "maximum": 3840
        },
        "maxViewportWidth": {
          "type": "integer",
          "minimum": 280,
          "maximum": 3840
        },
        "defaultBackgroundToken": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "visualRole": {
          "enum": [
            "primary-stage",
            "feature-stage",
            "support-stage"
          ]
        },
        "headerCompatibility": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "solid",
              "overlay-light"
            ]
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          }
        }
      }
    },
    "canvasSize": {
      "description": "用户选择的模板逻辑画布尺寸；根节点高度规则仍负责运行时高度。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "aspectRatio"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "aspectRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4096
        }
      }
    },
    "ratioLabel": {
      "type": "string",
      "pattern": "^(auto|[1-9][0-9]{0,3}:[1-9][0-9]{0,3})$"
    },
    "length": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "unit": {
          "enum": [
            "px",
            "%",
            "rem",
            "vw",
            "vh"
          ]
        }
      }
    },
    "size": {
      "oneOf": [
        {
          "enum": [
            "auto",
            "fill",
            "fit"
          ]
        },
        {
          "$ref": "#/$defs/length"
        }
      ]
    },
    "boxSpacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "$ref": "#/$defs/length"
        },
        "right": {
          "$ref": "#/$defs/length"
        },
        "bottom": {
          "$ref": "#/$defs/length"
        },
        "left": {
          "$ref": "#/$defs/length"
        }
      }
    },
    "heightRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "fit",
            "fill",
            "min-height",
            "aspect-ratio",
            "fixed",
            "viewport"
          ]
        },
        "value": {
          "$ref": "#/$defs/length"
        },
        "ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "zIndex"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "zIndex": {
          "type": "integer",
          "minimum": -10,
          "maximum": 10
        }
      }
    },
    "anchorOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "unit": {
          "enum": [
            "px",
            "%"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizontal",
        "vertical",
        "offsetX",
        "offsetY"
      ],
      "properties": {
        "horizontal": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "vertical": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "offsetX": {
          "$ref": "#/$defs/anchorOffset"
        },
        "offsetY": {
          "$ref": "#/$defs/anchorOffset"
        }
      }
    },
    "legacyResponsiveRules": {
      "allOf": [
        {
          "$ref": "#/$defs/responsiveRules"
        },
        {
          "properties": {
            "wrap": false,
            "minWidth": false,
            "maxHeight": false,
            "anchor": false,
            "hidden": false,
            "height": {
              "properties": {
                "mode": {
                  "enum": [
                    "auto",
                    "min-height",
                    "aspect-ratio",
                    "fixed",
                    "viewport"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "legacySlotRules": {
      "allOf": [
        {
          "$ref": "#/$defs/slotRules"
        },
        {
          "properties": {
            "objectPosition": {
              "pattern": "^(left|center|right) (top|center|bottom)$"
            }
          }
        }
      ]
    },
    "responsiveOverride": {
      "type": "object",
      "additionalProperties": false,
      "description": "schema2 有意修改的属性；缺失字段向上继承。长度和高度规则原子替换，四边间距和 placement 按成员继承。",
      "properties": {
        "hidden": {
          "type": "boolean"
        },
        "display": {
          "$ref": "#/$defs/responsiveRules/properties/display"
        },
        "direction": {
          "$ref": "#/$defs/responsiveRules/properties/direction"
        },
        "order": {
          "$ref": "#/$defs/responsiveRules/properties/order"
        },
        "width": {
          "$ref": "#/$defs/size"
        },
        "height": {
          "$ref": "#/$defs/heightRule"
        },
        "minWidth": {
          "$ref": "#/$defs/length"
        },
        "maxWidth": {
          "$ref": "#/$defs/length"
        },
        "minHeight": {
          "$ref": "#/$defs/length"
        },
        "maxHeight": {
          "$ref": "#/$defs/length"
        },
        "gap": {
          "$ref": "#/$defs/length"
        },
        "radius": {
          "$ref": "#/$defs/length"
        },
        "padding": {
          "$ref": "#/$defs/boxSpacingOverride"
        },
        "margin": {
          "$ref": "#/$defs/boxSpacingOverride"
        },
        "alignItems": {
          "$ref": "#/$defs/responsiveRules/properties/alignItems"
        },
        "justifyContent": {
          "$ref": "#/$defs/responsiveRules/properties/justifyContent"
        },
        "columns": {
          "$ref": "#/$defs/responsiveRules/properties/columns"
        },
        "backgroundToken": {
          "$ref": "#/$defs/responsiveRules/properties/backgroundToken"
        },
        "backgroundColor": {
          "$ref": "#/$defs/responsiveRules/properties/backgroundColor"
        },
        "backgroundImage": {
          "$ref": "#/$defs/responsiveRules/properties/backgroundImage"
        },
        "backgroundGradient": {
          "$ref": "#/$defs/responsiveRules/properties/backgroundGradient"
        },
        "opacity": {
          "$ref": "#/$defs/responsiveRules/properties/opacity"
        },
        "borderToken": {
          "$ref": "#/$defs/responsiveRules/properties/borderToken"
        },
        "overflow": {
          "$ref": "#/$defs/responsiveRules/properties/overflow"
        },
        "layoutMode": {
          "$ref": "#/$defs/responsiveRules/properties/layoutMode"
        },
        "wrap": {
          "$ref": "#/$defs/responsiveRules/properties/wrap"
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "placement": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "$ref": "#/$defs/placement/properties/x"
                },
                "y": {
                  "$ref": "#/$defs/placement/properties/y"
                },
                "width": {
                  "$ref": "#/$defs/placement/properties/width"
                },
                "height": {
                  "$ref": "#/$defs/placement/properties/height"
                },
                "zIndex": {
                  "$ref": "#/$defs/placement/properties/zIndex"
                }
              }
            }
          ]
        }
      }
    },
    "boxSpacingOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/length"
        },
        "right": {
          "$ref": "#/$defs/length"
        },
        "bottom": {
