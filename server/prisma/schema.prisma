// ========== 内容插槽（可视化编辑） ==========
// ContentSlot 模型已删除（2026-08-15 死资产清退）：写侧从未有入口、HOME_HERO 插槽永远为空，
// 页面内容统一由 PageDocument（Puck）承载；表由迁移 20260815100000_drop_content_slots 幂等删除。

// ========== 页面文档（Puck 页面级 JSON 存储）==========

model PageDocument {
  id                  Int       @id @default(autoincrement())
  pageKey             String    @unique @db.VarChar(50)
  schemaVersion       Int       @default(1) // 我们自己控制的数据版本
  editorType          String    @default("puck") @db.VarChar(30)
  editorVersion       String?   @db.VarChar(30) // 生成时的 Puck 版本
  templateId          String?   @map("template_id") @db.VarChar(50)
  templateVersion     Int?      @map("template_version")
  puckData            Json // Puck { content, root, zones }
  metadata            Json      @default("{}") // { title, seoDescription, slug, ... }
  status              String    @default("DRAFT") @db.VarChar(20) // DRAFT | PUBLISHED（兼容字段，线上事实以 publishedRevisionId 为准）
  publishedRevisionId Int?      @map("published_revision_id")
  publishedAt         DateTime? @map("published_at")
  publishedBy         Int?      @map("published_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  revisions         PageDocumentRevision[]     @relation("PageDocumentRevisions")
  publishedRevision PageDocumentRevision?      @relation("PagePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  localizations     PageDocumentLocalization[]

  @@index([status])
  @@index([publishedRevisionId])
  @@map("page_documents")
}

// ========== 页面文档版本历史 ==========

model PageDocumentRevision {
  id          Int       @id @default(autoincrement())
  documentId  Int       @map("document_id")
  version     Int
  puckData    Json
  metadata    Json      @default("{}")
  status      String    @default("published") @db.VarChar(20)
  publishedBy Int?      @map("published_by")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  document         PageDocument               @relation("PageDocumentRevisions", fields: [documentId], references: [id], onDelete: Cascade)
  publishedByPages PageDocument[]             @relation("PagePublishedRevision")
  publishedLocales PageDocumentLocalization[] @relation("PageLocalePublishedRevision")

  @@unique([documentId, version])
  @@map("page_document_revisions")
}

// ========== 页面装修方案（多套命名草稿快照，2026-08-16） ==========
// 与 PageDocumentRevision 职责区分：方案 = 运营主动保存的整页快照（可载入编辑/删除）；
// revision = 发布历史（自动生成，仅回滚用）。
model PageScheme {
  id        Int      @id @default(autoincrement())
  pageKey   String   @db.VarChar(50)
  name      String   @db.VarChar(100)
  puckData  Json
  metadata  Json     @default("{}")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pageKey, name])
  @@index([pageKey])
  @@map("page_schemes")
}

// ========== 账号私有内容模板 ==========
model PersonalContentTemplate {
  id              Int      @id @default(autoincrement())
  ownerId         Int      @map("owner_id")
  name            String   @db.VarChar(100)
  moduleType      String   @map("module_type") @db.VarChar(100)
  contractKey     String   @map("contract_key") @db.VarChar(50)
  contractVersion Int      @map("contract_version")
  layoutData      Json     @map("layout_data")
  revision        Int      @default(1)
  // 运营明确选择后保存的合同白名单默认内容；禁止复制价格、库存、客户及其他业务事实。
  contentDefaults Json?    @map("content_defaults")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt])
  @@map("personal_content_templates")
}

// ========== 动态内容模板（草稿与不可变正式版本）==========

enum DynamicTemplateSourceType {
  SYSTEM
  CUSTOM
}

enum DynamicTemplateVisibility {
  PRIVATE
  STAFF
}

enum DynamicTemplateStatus {
  ACTIVE
  ARCHIVED
}

model DynamicTemplate {
  id                      Int                       @id @default(autoincrement())
  templateId              String                    @unique @map("template_id") @db.VarChar(128)
  ownerId                 Int?                      @map("owner_id")
  sourceType              DynamicTemplateSourceType @default(CUSTOM) @map("source_type")
  visibility              DynamicTemplateVisibility @default(PRIVATE)
  status                  DynamicTemplateStatus     @default(ACTIVE)
  name                    String                    @db.VarChar(100)
  category                String                    @db.VarChar(50)
  purpose                 String                    @db.VarChar(100)
  layoutType              String                    @map("layout_type") @db.VarChar(50)
  description             String?                   @db.Text
  slotSummary             String                    @map("slot_summary") @db.VarChar(200)
  recommendedFor          Json                      @map("recommended_for")
  tags                    Json
  definitionSchemaVersion Int                       @map("definition_schema_version")
  publishedVersion        Int                       @default(0) @map("published_version")
  sourceReference         String?                   @map("source_reference") @db.VarChar(128)
  archivedAt              DateTime?                 @map("archived_at")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  owner       User?                       @relation("DynamicTemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  draft       DynamicTemplateDraft?
  versions    DynamicTemplateVersion[]
  activations DynamicTemplateActivation[]

  @@unique([ownerId, name])
  @@index([ownerId, status, updatedAt])
  @@index([visibility, status, updatedAt])
  @@map("dynamic_templates")
}

model DynamicTemplateDraft {
  id                 Int      @id @default(autoincrement())
  dynamicTemplateId  Int      @unique @map("dynamic_template_id")
  baseVersion        Int?     @map("base_version")
  revision           Int      @default(1)
  definition         Json
  definitionChecksum String   @map("definition_checksum") @db.Char(64)
  versionNote        String?  @map("version_note") @db.VarChar(500)
  updatedById        Int?     @map("updated_by_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  template  DynamicTemplate @relation(fields: [dynamicTemplateId], references: [id], onDelete: Cascade)
  updatedBy User?           @relation("DynamicTemplateDraftUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@map("dynamic_template_drafts")
}

model DynamicTemplateVersion {
  id                 Int      @id @default(autoincrement())
  dynamicTemplateId  Int      @map("dynamic_template_id")
  version            Int
  schemaVersion      Int      @map("schema_version")
  definition         Json
  definitionChecksum String   @map("definition_checksum") @db.Char(64)
  versionNote        String?  @map("version_note") @db.VarChar(500)
  publishedById      Int?     @map("published_by_id")
  publishedAt        DateTime @default(now()) @map("published_at")

  template    DynamicTemplate @relation(fields: [dynamicTemplateId], references: [id], onDelete: Restrict)
  publishedBy User?           @relation("DynamicTemplateVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([dynamicTemplateId, version])
  @@index([dynamicTemplateId, publishedAt])
  @@index([definitionChecksum])
  @@map("dynamic_template_versions")
}

model DynamicTemplateActivation {
  id                             BigInt   @id @default(autoincrement())
  dynamicTemplateId              Int      @map("dynamic_template_id")
  fromVersion                    Int      @map("from_version")
  toVersion                      Int      @map("to_version")
  expectedDraftRevision          Int      @map("expected_draft_revision")
  draftChecksum                  String   @map("draft_checksum") @db.Char(64)
  impactHash                     String   @map("impact_hash") @db.Char(64)
  idempotencyKeyHash             String   @unique @map("idempotency_key_hash") @db.Char(64)
  requestHash                    String   @map("request_hash") @db.Char(64)
  affectedDocumentCount          Int      @map("affected_document_count")
  affectedDraftInstanceCount     Int      @map("affected_draft_instance_count")
  affectedPublishedInstanceCount Int      @map("affected_published_instance_count")
  affectedSchemeCount            Int      @map("affected_scheme_count")
  affectedSchemeInstanceCount    Int      @map("affected_scheme_instance_count")
  createdPageRevisionCount       Int      @map("created_page_revision_count")
  resultSummary                  Json     @map("result_summary")
  activatedById                  Int?     @map("activated_by_id")
  activatedAt                    DateTime @default(now()) @map("activated_at")

  template    DynamicTemplate @relation(fields: [dynamicTemplateId], references: [id], onDelete: Restrict)
  activatedBy User?           @relation("DynamicTemplateActivationActor", fields: [activatedById], references: [id], onDelete: SetNull)

  @@unique([dynamicTemplateId, toVersion])
  @@index([dynamicTemplateId, activatedAt], map: "dynamic_template_activations_template_activated_idx")
  @@map("dynamic_template_activations")
}

// ========== 选款咨询 ==========

model SelectionInquiry {
  id                    Int       @id @default(autoincrement())
  customerId            Int?      @map("customer_id")
  customerName          String    @map("customer_name") @db.VarChar(50)
  phone                 String?   @db.VarChar(20)
  email                 String?   @db.VarChar(100)
  wechat                String?   @db.VarChar(50)
  message               String?   @db.Text
  privacyConsent        Boolean   @default(false) @map("privacy_consent")
  privacyConsentVersion String?   @map("privacy_consent_version") @db.VarChar(50)
  privacyConsentedAt    DateTime? @map("privacy_consented_at")
  status                String    @default("PENDING") @db.VarChar(20)
  internalNote          String?   @map("internal_note") @db.Text
  handledBy             Int?      @map("handled_by")
  handledAt             DateTime? @map("handled_at")
  nextFollowUpAt        DateTime? @map("next_follow_up_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  items    SelectionInquiryItem[]
  customer Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handler  User?                  @relation("Handler", fields: [handledBy], references: [id])
  lead     Lead?

  @@index([status])
  @@index([customerId, createdAt])
  @@index([createdAt]) // dashboard 今日选款咨询计数
  @@map("selection_inquiries")
}

model SelectionInquiryItem {
  id                   Int      @id @default(autoincrement())
  selectionInquiryId   Int      @map("selection_inquiry_id")
  productId            Int?     @map("product_id")
  productNameSnapshot  String   @map("product_name_snapshot") @db.VarChar(200)
  productSkuSnapshot   String?  @map("product_sku_snapshot") @db.VarChar(100)
  productImageSnapshot String?  @map("product_image_snapshot") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at")

  inquiry SelectionInquiry @relation(fields: [selectionInquiryId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("selection_inquiry_items")
}

// ========== 统一线索跟进记录 ==========

model LeadFollowUp {
  id             Int       @id @default(autoincrement())
  leadType       String    @db.VarChar(30) // "inquiry" | "selection_inquiry"
  leadId         Int       @map("lead_id")
  content        String    @db.Text
  contactMethod  String?   @map("contact_method") @db.VarChar(30) // phone | wechat | email | store | other
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  creator User? @relation("Creator", fields: [createdBy], references: [id])

  @@index([leadType, leadId])
  @@map("lead_follow_ups")
}

enum LeadSourceType {
  INQUIRY
  SELECTION_INQUIRY
}

enum LeadStatus {
  PENDING
  CONTACTED
  FOLLOWING
  COMPLETED
  INVALID
}

enum LeadActivityType {
  CREATED
  ASSIGNED
  STATUS_CHANGED
  REOPENED
  FOLLOW_UP
  REPLY
  NOTE
}

enum LeadPrivacyDisposition {
  ANONYMIZED
}

// 统一线索运营事实。原 Inquiry / SelectionInquiry 继续保存原始提交内容，
// 本表只维护跨来源一致的分配、联系、跟进、完结和留存状态。
model Lead {
  id                    Int                     @id @default(autoincrement())
  sourceType            LeadSourceType          @map("source_type")
  inquiryId             Int?                    @unique @map("inquiry_id")
  selectionInquiryId    Int?                    @unique @map("selection_inquiry_id")
  customerId            Int?                    @map("customer_id")
  customerName          String                  @map("customer_name") @db.VarChar(50)
  phone                 String?                 @db.VarChar(20)
  email                 String?                 @db.VarChar(100)
  wechat                String?                 @db.VarChar(50)
  status                LeadStatus              @default(PENDING)
  assignedTo            Int?                    @map("assigned_to")
  internalNote          String?                 @map("internal_note") @db.Text
  closureReason         String?                 @map("closure_reason") @db.Text
  nextFollowUpAt        DateTime?               @map("next_follow_up_at")
  closedAt              DateTime?               @map("closed_at")
  retentionUntil        DateTime?               @map("retention_until")
  legalHoldAt           DateTime?               @map("legal_hold_at")
  legalHoldReason       String?                 @map("legal_hold_reason") @db.VarChar(50)
  legalHoldBy           Int?                    @map("legal_hold_by")
  privacyDisposition    LeadPrivacyDisposition? @map("privacy_disposition")
  privacyDisposedAt     DateTime?               @map("privacy_disposed_at")
  privacyDisposedBy     Int?                    @map("privacy_disposed_by")
  idempotencyKeyHash    String?                 @unique @map("idempotency_key_hash") @db.Char(64)
  submissionFingerprint String?                 @map("submission_fingerprint") @db.Char(64)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  inquiry          Inquiry?          @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  selectionInquiry SelectionInquiry? @relation(fields: [selectionInquiryId], references: [id], onDelete: Restrict)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee         User?             @relation("LeadAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  legalHoldActor   User?             @relation("LeadLegalHoldActor", fields: [legalHoldBy], references: [id], onDelete: SetNull)
  dispositionActor User?             @relation("LeadPrivacyDispositionActor", fields: [privacyDisposedBy], references: [id], onDelete: SetNull)
  activities       LeadActivity[]

  @@index([sourceType, createdAt])
  @@index([status, createdAt])
  @@index([assignedTo, status, nextFollowUpAt])
  @@index([customerId, createdAt])
  @@index([retentionUntil])
  @@index([retentionUntil, legalHoldAt, privacyDisposedAt])
  @@index([legalHoldBy, legalHoldAt])
  @@index([privacyDisposedBy, privacyDisposedAt])
  @@map("leads")
}

model LeadActivity {
  id                 Int              @id @default(autoincrement())
  leadId             Int              @map("lead_id")
  type               LeadActivityType
  content            String?          @db.Text
  contactMethod      String?          @map("contact_method") @db.VarChar(30)
  previousStatus     LeadStatus?      @map("previous_status")
  currentStatus      LeadStatus?      @map("current_status")
  nextFollowUpAt     DateTime?        @map("next_follow_up_at")
  createdBy          Int?             @map("created_by")
  idempotencyKeyHash String?          @unique @map("idempotency_key_hash") @db.Char(64)
  metadata           Json?
  createdAt          DateTime         @default(now()) @map("created_at")

  lead    Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  creator User? @relation("LeadActivityCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([createdBy, createdAt])
  @@map("lead_activities")
}

// ========== 统一行为事件采集 ==========

model AnalyticsEvent {
  id                 Int              @id @default(autoincrement())
  dataset            AnalyticsDataset @default(TEST)
  eventName          String           @db.VarChar(50)
  occurredAt         DateTime         @default(now()) @map("occurred_at")
  pagePath           String?          @map("page_path") @db.VarChar(300)
  productId          Int?             @map("product_id")
  searchTerm         String?          @map("search_term") @db.VarChar(200)
  source             String?          @db.VarChar(50)
  deviceType         String?          @map("device_type") @db.VarChar(20)
  sessionId          String?          @map("session_id") @db.VarChar(100)
  visitorIdHash      String?          @map("visitor_id_hash") @db.Char(64)
  countryCode        String?          @map("country_code") @db.VarChar(2)
  region             String?          @db.VarChar(100)
  city               String?          @db.VarChar(100)
  customerId         Int?             @map("customer_id")
  metadata           Json?
  retentionExpiresAt DateTime         @map("retention_expires_at")

  @@index([eventName, occurredAt]) // dashboard page_view 复合查询（最左前缀覆盖纯 eventName）
  @@index([occurredAt])
  @@index([sessionId])
  @@index([dataset, eventName, occurredAt], map: "analytics_events_dataset_event_time_idx")
  @@index([dataset, visitorIdHash, occurredAt], map: "analytics_events_dataset_visitor_time_idx")
  @@index([dataset, retentionExpiresAt], map: "analytics_events_retention_idx")
  @@map("analytics_events")
}

enum AnalyticsDataset {
  PRODUCTION
  TEST
}

// ========== 合作商家申请（受控商家体系）==========
// 保留完整历史记录：每次提交/补充都新增一行，不覆盖旧记录，便于审计。
model PartnerApplication {
  id                    Int                      @id @default(autoincrement())
  customerId            Int                      @map("customer_id")
  applicantName         String                   @map("applicant_name") @db.VarChar(50)
  applicantPhone        String                   @map("applicant_phone") @db.VarChar(20)
  companyName           String?                  @map("company_name") @db.VarChar(200)
  city                  String?                  @db.VarChar(100)
  businessType          String?                  @map("business_type") @db.VarChar(50)
  channelType           String?                  @map("channel_type") @db.VarChar(50)
  businessDescription   String?                  @map("business_description") @db.Text
  expectedPurchaseRange String?                  @map("expected_purchase_range") @db.VarChar(50)
  contactWechat         String?                  @map("contact_wechat") @db.VarChar(50)
  status                PartnerApplicationStatus @default(PENDING)
  reviewNote            String?                  @map("review_note") @db.Text
  reviewerId            Int?                     @map("reviewer_id")
  submittedAt           DateTime                 @default(now()) @map("submitted_at")
  reviewedAt            DateTime?                @map("reviewed_at")
  // 合作协议同意时间：必填，记录客户勾选协议的确切时间，作为合规凭证
  agreementAcceptedAt   DateTime                 @map("agreement_accepted_at")
  agreementVersion      String?                  @map("agreement_version") @db.VarChar(50)
  agreementHash         String?                  @map("agreement_hash") @db.Char(64)
