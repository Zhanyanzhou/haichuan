generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户与权限 ==========

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique @db.VarChar(50)
  password    String    @db.VarChar(255)
  realName    String?   @map("real_name") @db.VarChar(50)
  phone       String?   @db.VarChar(20)
  email       String?   @db.VarChar(100)
  avatar      String?   @db.VarChar(500)
  role        Role      @default(EDITOR)
  status      Status    @default(ACTIVE)
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  operationLogs      OperationLog[]
  aiClassifyRecords  AIClassifyRecord[] @relation("Operator")
  inquiries          Inquiry[]          @relation("AssignedTo")
  notifications      Notification[]
  Order              Order[]
  selectionInquiries SelectionInquiry[] @relation("Handler")
  leadFollowUps      LeadFollowUp[]     @relation("Creator")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER_SERVICE
  WAREHOUSE
}

enum Status {
  ACTIVE
  DISABLED
}

// ========== 分类管理（四级自关联） ==========

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(150)
  level       Int       @default(1) // 1-4
  parentId    Int?      @map("parent_id")
  icon        String?   @db.VarChar(500)
  coverImage  String?   @map("cover_image") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  seoTitle    String?   @map("seo_title") @db.VarChar(200)
  seoDesc     String?   @map("seo_desc") @db.VarChar(500)
  seoKeywords String?   @map("seo_keywords") @db.VarChar(300)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") // 软删除标记
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

// ========== 产品管理（核心） ==========

model Product {
  id               Int           @id @default(autoincrement())
  code             String        @unique @db.VarChar(50) // 产品编码/货号
  name             String        @db.VarChar(200)
  shortDescription String?       @map("short_description") @db.VarChar(500) // 简介
  description      String?       @db.Text
  categoryId       Int           @map("category_id")
  materialType     MaterialType  @default(GOLD_999) @map("material_type")
  goldWeight       Decimal?      @default(0) @map("gold_weight") @db.Decimal(8, 2) // 金重(g)
  craftFee         Decimal?      @default(0) @map("craft_fee") @db.Decimal(10, 2) // 工费
  price            Decimal?      @default(0) @db.Decimal(10, 2) // 当前售价
  priceMin         Decimal?      @default(0) @map("price_min") @db.Decimal(10, 2)
  priceMax         Decimal?      @default(0) @map("price_max") @db.Decimal(10, 2)
  weight           Decimal?      @default(0) @db.Decimal(8, 2) // 总重量(g)
  size             String?       @db.VarChar(100) // 尺寸规格
  gemInfo          Json?         @map("gem_info") // 宝石信息JSON
  craftTechnique   Json?         @map("craft_technique") // 工艺技法JSON
  status           ProductStatus @default(DRAFT)
  salesMode        SalesMode     @default(DISPLAY_ONLY) @map("sales_mode")
  sortOrder        Int           @default(0) @map("sort_order")
  isHot            Boolean       @default(false) @map("is_hot")
  isNew            Boolean       @default(false) @map("is_new")
  isRecommended    Boolean       @default(false) @map("is_recommended")
  isLimited        Boolean       @default(false) @map("is_limited")
  isCustom         Boolean       @default(false) @map("is_custom")
  multiDiscount    Boolean       @default(false) @map("multi_discount")
  viewCount        Int           @default(0) @map("view_count")
  salesCount       Int           @default(0) @map("sales_count")
  publishedAt      DateTime?     @map("published_at")
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category              Category               @relation(fields: [categoryId], references: [id])
  images                ProductImage[]
  primaryImageId        Int?                   @map("primary_image_id")
  listingImageId        Int?                   @map("listing_image_id")
  primaryImage          ProductImage?          @relation("PrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  listingImage          ProductImage?          @relation("ListingImage", fields: [listingImageId], references: [id], onDelete: SetNull)
  skus                  ProductSKU[]
  tags                  ProductTag[]
  certificates          Certificate[]
  seriesItems           SeriesItem[]
  inquiries             Inquiry[]
  orderItems            OrderItem[]
  cartItems             Cart[]
  selectionInquiryItems SelectionInquiryItem[]

  @@index([categoryId])
  @@index([status])
  @@index([materialType])
  @@index([isHot])
  @@index([categoryId, status]) // 复合索引：按分类+状态查询
  @@index([deletedAt]) // 软删除过滤
  @@map("products")
}

enum MaterialType {
  GOLD_999 // 足金999
  GOLD_9999 // 足金9999
  AU750 // K金
  PT950 // 铂金
  S925 // 银
  DIAMOND // 镶钻
  JADE // 玉石
  PEARL // 珍珠
  COLOR_GEM // 彩宝
  OTHER
}

enum ProductStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布(上架)
  OFFLINE // 已下架
  ARCHIVED // 已归档
}

enum SalesMode {
  DISPLAY_ONLY // 仅展示
  SELECTION // 选款模式
  APPOINTMENT // 预约模式
  DIRECT_PURCHASE // 直接购买(暂未开放)
  CUSTOM_INQUIRY // 定制咨询
}

// ========== 产品图片（三视图） ==========

model ProductImage {
  id            Int       @id @default(autoincrement())
  productId     Int       @map("product_id")
  url           String    @db.VarChar(500)
  type          ImageType @default(FRONT) // 正面/侧面/顶部/视频
  sortOrder     Int       @default(0) @map("sort_order")
  isVideo       Boolean   @default(false) @map("is_video")
  sourceImageId Int?      @map("source_image_id")
  cropData      Json?     @map("crop_data")
  width         Int?
  height        Int?
  mimeType      String?   @map("mime_type") @db.VarChar(50)
  fileSize      Int?      @map("file_size")
  createdAt     DateTime  @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceImage   ProductImage?  @relation("SourceImage", fields: [sourceImageId], references: [id], onDelete: SetNull)
  derivedImages ProductImage[] @relation("SourceImage")
  primaryOf     Product[]      @relation("PrimaryImage")
  listingOf     Product[]      @relation("ListingImage")

  @@map("product_images")
}

enum ImageType {
  FRONT
  SIDE
  TOP
  DETAIL
  WEARING
}

// ========== 产品SKU ==========

model ProductSKU {
  id          Int          @id @default(autoincrement())
  productId   Int          @map("product_id")
  skuCode     String       @unique @map("sku_code") @db.VarChar(100)
  material    MaterialType @default(GOLD_999)
  size        String?      @db.VarChar(50)
  goldWeight  Decimal?     @map("gold_weight") @db.Decimal(8, 2)
  price       Decimal      @default(0) @db.Decimal(10, 2)
  stock       Int          @default(0) // @deprecated 库存请通过 InventoryService 统一管理
  safetyStock Int          @default(5) @map("safety_stock")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories Inventory[]
  orderItems  OrderItem[]
  cartItems   Cart[]
  reservations InventoryReservation[]

  @@map("product_skus")
}

// ========== 产品标签 ==========

model ProductTag {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  tagName   String @map("tag_name") @db.VarChar(50)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tagName])
  @@map("product_tags")
}

// ========== 产品系列/套装 ==========

model ProductSeries {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  coverImage  String?  @map("cover_image") @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  items SeriesItem[]

  @@map("product_series")
}

model SeriesItem {
  id        Int @id @default(autoincrement())
  seriesId  Int @map("series_id")
  productId Int @map("product_id")
  sortOrder Int @default(0) @map("sort_order")

  series  ProductSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([seriesId, productId])
  @@map("series_items")
}

// ========== 产品证书 ==========

model Certificate {
  id         Int       @id @default(autoincrement())
  productId  Int       @map("product_id")
  certType   CertType  @map("cert_type")
  certNumber String    @map("cert_number") @db.VarChar(100)
  certImage  String?   @map("cert_image") @db.VarChar(500)
  expireDate DateTime? @map("expire_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

enum CertType {
  NATIONAL // 国检
  PROVINCIAL // 省检
  GIA // GIA
  OTHER
}

// ========== 金价管理 ==========

model GoldPrice {
  id         Int             @id @default(autoincrement())
  price      Decimal         @db.Decimal(10, 2) // 每克金价(元)
  source     GoldPriceSource @default(AUTO)
  operatorId Int?            @map("operator_id") // 手动录入时的操作人
  remark     String?         @db.VarChar(500)
  recordDate DateTime        @default(now()) @map("record_date")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([recordDate])
  @@map("gold_prices")
}

enum GoldPriceSource {
  AUTO
  MANUAL
}

// ========== 调价历史 ==========

model PriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  oldPrice   Decimal  @map("old_price") @db.Decimal(10, 2)
  newPrice   Decimal  @map("new_price") @db.Decimal(10, 2)
  goldPrice  Decimal  @map("gold_price") @db.Decimal(10, 2)
  operatorId Int      @map("operator_id")
  reason     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdAt])
  @@map("price_history")
}

// ========== 库存管理 ==========

model Warehouse {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(100)
  type      WarehouseType
  address   String?       @db.VarChar(300)
  contact   String?       @db.VarChar(50)
  phone     String?       @db.VarChar(20)
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")

  inventories Inventory[]

  @@map("warehouses")
}

enum WarehouseType {
  SHOWROOM // 展厅
  FACTORY // 工厂
  STORE // 门店
}

model Inventory {
  id          Int       @id @default(autoincrement())
  skuId       Int       @map("sku_id")
  warehouseId Int       @map("warehouse_id")
  quantity    Int       @default(0)
  safetyStock Int       @default(5) @map("safety_stock")
  lastCheckAt DateTime? @map("last_check_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sku       ProductSKU @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  reservations InventoryReservation[]

  @@unique([skuId, warehouseId])
  @@map("inventories")
}

// ========== 订单管理 ==========

model Order {
  id               Int         @id @default(autoincrement())
  orderNo          String      @unique @map("order_no") @db.VarChar(30)
  userId           Int?        @map("user_id") // 关联注册用户（可选，兼容游客下单）
  customerName     String      @map("customer_name") @db.VarChar(50)
  customerId       Int?        @map("customer_id")
  customerPhone    String      @map("customer_phone") @db.VarChar(20)
  customerEmail    String?     @map("customer_email") @db.VarChar(100)
  address          String      @db.VarChar(500)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(12, 2)
  discountAmount   Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount      Decimal     @map("final_amount") @db.Decimal(12, 2)
  status           OrderStatus @default(PENDING_PAYMENT)
  paymentMethod    String?     @map("payment_method") @db.VarChar(50)
  paymentProof     String?     @map("payment_proof") @db.VarChar(500)
  logisticsCompany String?     @map("logistics_company") @db.VarChar(50)
  logisticsNo      String?     @map("logistics_no") @db.VarChar(100)
  internalNote     String?     @map("internal_note") @db.Text
  lockedGoldPrice  Decimal?    @map("locked_gold_price") @db.Decimal(10, 2)
  reservedAt       DateTime?   @map("reserved_at")
  paymentConfirmedAt DateTime? @map("payment_confirmed_at")
  shippedAt        DateTime?   @map("shipped_at")
  completedAt      DateTime?   @map("completed_at")
  cancelledAt      DateTime?   @map("cancelled_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  reservations InventoryReservation[]
  user     User?       @relation(fields: [userId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  couponId Int?        @map("coupon_id")

  @@index([orderNo])
  @@index([status])
  @@index([customerPhone])
  @@index([customerPhone, createdAt]) // 复合索引：按手机+时间查订单
  @@index([userId, createdAt]) // 复合索引：按用户+时间查订单
  @@index([customerId, createdAt])
  @@map("orders")
}

model Customer {
  id          Int               @id @default(autoincrement())
  phone       String            @unique @db.VarChar(20)
  name        String?           @db.VarChar(50)
  email       String?           @db.VarChar(100)
  passwordHash String?          @map("password_hash") @db.VarChar(255)
  status      Status            @default(ACTIVE)
  lastOrderAt DateTime?         @map("last_order_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  addresses CustomerAddress[]
  orders    Order[]
  inquiries Inquiry[]
  selectionInquiries SelectionInquiry[]

  @@map("customers")
}

model CustomerAddress {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  recipientName  String   @map("recipient_name") @db.VarChar(50)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  province       String?  @db.VarChar(50)
  city           String?  @db.VarChar(50)
  district       String?  @db.VarChar(50)
  detail         String   @db.VarChar(300)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

enum OrderStatus {
  PENDING_PAYMENT // 待付款
  PENDING_SHIP // 待发货
  SHIPPED // 已发货
  COMPLETED // 已完成
  CANCELLED // 已取消
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int      @map("order_id")
  skuId                Int      @map("sku_id")
  productId            Int      @map("product_id")
  quantity             Int      @default(1)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(10, 2)
  // 成交快照 — 商品后续修改不影响历史订单
  productNameSnapshot  String?  @map("product_name_snapshot") @db.VarChar(200)
  productImageSnapshot String?  @map("product_image_snapshot") @db.VarChar(500)
  productCodeSnapshot  String?  @map("product_code_snapshot") @db.VarChar(50)
  skuSnapshot          String?  @map("sku_snapshot") @db.VarChar(200)
  actualWeight         Decimal? @map("actual_weight") @db.Decimal(8, 2)
  certNumber           String?  @map("cert_number") @db.VarChar(100)

  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku     ProductSKU @relation(fields: [skuId], references: [id])
  product Product    @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// 库存预占明细：记录订单锁定的具体仓位，供支付确认、取消和超时释放使用。
model InventoryReservation {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  inventoryId Int?      @map("inventory_id")
  skuId       Int       @map("sku_id")
  quantity    Int
  expiresAt   DateTime  @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory Inventory?  @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  sku       ProductSKU  @relation(fields: [skuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inventoryId])
  @@index([skuId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

// ========== 支付管理 ==========

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @map("order_id")
  paymentNo      String        @unique @map("payment_no") @db.VarChar(50)
  amount         Decimal       @db.Decimal(12, 2)
  method         String        @db.VarChar(30) // wechat | alipay | bank_transfer | store
  status         PaymentStatus @default(PENDING)
  type           String        @default("FULL") @db.VarChar(20) // DEPOSIT | BALANCE | FULL
  gatewayTradeNo String?       @map("gateway_trade_no") @db.VarChar(100)
  gatewayNotify  Json?         @map("gateway_notify")
  proofUrl       String?       @map("proof_url") @db.VarChar(500)
  reviewedBy     Int?          @map("reviewed_by")
  reviewedAt     DateTime?     @map("reviewed_at")
  reviewNote     String?       @map("review_note") @db.VarChar(500)
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@index([paymentNo])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

// ========== 退款管理 ==========

model Refund {
  id              Int          @id @default(autoincrement())
  orderId         Int          @map("order_id")
  paymentId       Int?         @map("payment_id")
  refundNo        String       @unique @map("refund_no") @db.VarChar(50)
  amount          Decimal      @db.Decimal(12, 2)
  reason          String?      @db.VarChar(500)
  status          RefundStatus @default(PENDING)
  gatewayRefundNo String?      @map("gateway_refund_no") @db.VarChar(100)
  processedAt     DateTime?    @map("processed_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// ========== 购物车 ==========

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(100)
  skuId     Int      @map("sku_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     ProductSKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([userId, createdAt]) // 复合索引
  @@map("carts")
}

// ========== 询价/咨询 ==========

model Inquiry {
  id               Int       @id @default(autoincrement())
  productId        Int?      @map("product_id")
  customerId       Int?      @map("customer_id")
  customerName     String    @map("customer_name") @db.VarChar(50)
  customerPhone    String    @map("customer_phone") @db.VarChar(20)
  customerEmail    String?   @map("customer_email") @db.VarChar(100)
  consultationType String?   @map("consultation_type") @db.VarChar(30)
  preferredContact String?   @map("preferred_contact") @db.VarChar(20)
  preferredTime    String?   @map("preferred_time") @db.VarChar(20)
  budgetRange      String?   @map("budget_range") @db.VarChar(30)
  message          String    @db.Text
  privacyConsent   Boolean   @default(false) @map("privacy_consent")
  status           String    @default("PENDING") @db.VarChar(20)
  assignedTo       Int?      @map("assigned_to")
  reply            String?   @db.Text
  internalNote     String?   @map("internal_note") @db.Text
  nextFollowUpAt   DateTime? @map("next_follow_up_at")
  repliedAt        DateTime? @map("replied_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  product  Product? @relation(fields: [productId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee User?    @relation("AssignedTo", fields: [assignedTo], references: [id])

  @@index([status])
  @@index([customerId, createdAt])
  @@map("inquiries")
}

enum InquiryStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  REPLIED // 已回复
  CLOSED // 已关闭
}

// ========== 通知消息 ==========

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   @db.VarChar(50) // order/audit/stock/gold_price/inquiry
  title     String   @db.VarChar(200)
  content   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  link      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ========== 操作日志 ==========

model OperationLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(100) // create/update/delete/login/logout
  module    String   @db.VarChar(50) // product/category/order/user/gold_price
  targetId  Int?     @map("target_id")
  detail    String?  @db.Text
  ip        String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("operation_logs")
}

// ========== AI识别记录 ==========

model AIClassifyRecord {
  id                  Int      @id @default(autoincrement())
  imageUrl            String   @map("image_url") @db.VarChar(500)
  predictedCategoryId Int?     @map("predicted_category_id")
  confidence          Decimal? @db.Decimal(5, 2) // 置信度 0-100
  confirmedCategoryId Int?     @map("confirmed_category_id")
  operatorId          Int?     @map("operator_id")
  productId           Int?     @map("product_id")
  status              String   @default("pending") @db.VarChar(20) // auto_confirmed/pending_confirm/pending_review/confirmed/manual
  createdAt           DateTime @default(now()) @map("created_at")

  operator User? @relation("Operator", fields: [operatorId], references: [id])

  @@index([status])
  @@map("ai_classify_records")
}

// ========== 营销活动 ==========

model Promotion {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(200)
  type        PromotionType
  rule        Json // 满减/折扣规则JSON
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  isActive    Boolean       @default(true) @map("is_active")
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("promotions")
}

enum PromotionType {
  FULL_REDUCTION // 满减
  DISCOUNT // 折扣
  GIFT // 赠品
}

model Coupon {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(200)
  type       String   @db.VarChar(20) // fixed/percent
  value      Decimal  @db.Decimal(10, 2) // 面值或折扣率
  minAmount  Decimal  @default(0) @map("min_amount") @db.Decimal(10, 2)
  totalCount Int      @default(100) @map("total_count")
  usedCount  Int      @default(0) @map("used_count")
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("coupons")
}

// ========== 首页DIY配置 ==========

model HomeSection {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(30) // hero/story/categories/products/craft/contact
  title     String?  @db.VarChar(200)
  subtitle  String?  @db.VarChar(300)
  content   String?  @db.Text
  imageUrl  String?  @map("image_url") @db.VarChar(500)
  videoUrl  String?  @map("video_url") @db.VarChar(500)
  linkUrl   String?  @map("link_url") @db.VarChar(500)
  linkText  String?  @map("link_text") @db.VarChar(50)
  settings  Json?
  isEnabled Boolean  @default(true) @map("is_enabled")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_sections")
}

// ========== 内容插槽（可视化编辑） ==========

model ContentSlot {
  id           Int      @id @default(autoincrement())
  slotKey      String   @unique @db.VarChar(100)
  pageKey      String   @db.VarChar(50)
  sectionKey   String   @db.VarChar(50)
  contentType  String   @default("image") @db.VarChar(20)
  desktopAsset String?  @map("desktop_asset") @db.VarChar(500)
  mobileAsset  String?  @map("mobile_asset") @db.VarChar(500)
  title        String?  @db.VarChar(300)
  subtitle     String?  @db.VarChar(500)
  linkUrl      String?  @map("link_url") @db.VarChar(500)
  altText      String?  @map("alt_text") @db.VarChar(200)
  sortOrder    Int      @default(0) @map("sort_order")
  isVisible    Boolean  @default(true) @map("is_visible")
  status       String   @default("DRAFT") @db.VarChar(20)
  updatedBy    Int?     @map("updated_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([pageKey])
  @@index([status])
  @@map("content_slots")
}

// ========== 页面文档（Puck 页面级 JSON 存储）==========

model PageDocument {
  id              Int       @id @default(autoincrement())
  pageKey         String    @unique @db.VarChar(50)
  schemaVersion   Int       @default(1) // 我们自己控制的数据版本
  editorType      String    @default("puck") @db.VarChar(30)
  editorVersion   String?   @db.VarChar(30) // 生成时的 Puck 版本
  templateId      String?   @map("template_id") @db.VarChar(50)
  templateVersion Int?      @map("template_version")
  puckData        Json // Puck { content, root, zones }
  metadata        Json      @default("{}") // { title, seoDescription, slug, ... }
  status          String    @default("DRAFT") @db.VarChar(20) // DRAFT | PUBLISHED
  publishedAt     DateTime? @map("published_at")
  publishedBy     Int?      @map("published_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("page_documents")
}

// ========== 页面文档版本历史 ==========

model PageDocumentRevision {
  id          Int       @id @default(autoincrement())
  documentId  Int       @map("document_id")
  version     Int
  puckData    Json
  metadata    Json      @default("{}")
  status      String    @default("published") @db.VarChar(20)
  publishedBy Int?      @map("published_by")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([documentId, version])
  @@map("page_document_revisions")
}

// ========== 页面模板 ==========

model PageTemplate {
  id                String   @id @db.VarChar(50) // "jewelry-home-v1"
  name              String   @db.VarChar(100)
  pageType          String   @default("custom") @db.VarChar(30)
  defaultPuckData   Json // 模板默认 Puck 数据
  allowedBlockTypes Json     @default("[]") // ["hero", "imageText", ...]
  lockedComponents  Json     @default("[]") // ["hero-locked"]
  permissions       Json     @default("{}") // 模板级权限
  version           Int      @default(1)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("page_templates")
}

// ========== 选款咨询 ==========

model SelectionInquiry {
  id             Int       @id @default(autoincrement())
  customerId     Int?      @map("customer_id")
  customerName   String    @map("customer_name") @db.VarChar(50)
  phone          String?   @db.VarChar(20)
  email          String?   @db.VarChar(100)
  wechat         String?   @db.VarChar(50)
  message        String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(20)
  internalNote   String?   @map("internal_note") @db.Text
  handledBy      Int?      @map("handled_by")
  handledAt      DateTime? @map("handled_at")
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  items   SelectionInquiryItem[]
  customer Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handler User?                  @relation("Handler", fields: [handledBy], references: [id])

  @@index([status])
  @@index([customerId, createdAt])
  @@map("selection_inquiries")
}

model SelectionInquiryItem {
  id                   Int      @id @default(autoincrement())
  selectionInquiryId   Int      @map("selection_inquiry_id")
  productId            Int?     @map("product_id")
  productNameSnapshot  String   @map("product_name_snapshot") @db.VarChar(200)
  productSkuSnapshot   String?  @map("product_sku_snapshot") @db.VarChar(100)
  productImageSnapshot String?  @map("product_image_snapshot") @db.VarChar(500)
  createdAt            DateTime @default(now()) @map("created_at")

  inquiry SelectionInquiry @relation(fields: [selectionInquiryId], references: [id], onDelete: Cascade)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("selection_inquiry_items")
}

// ========== 统一线索跟进记录 ==========

model LeadFollowUp {
  id             Int       @id @default(autoincrement())
  leadType       String    @db.VarChar(30) // "inquiry" | "selection_inquiry"
  leadId         Int       @map("lead_id")
  content        String    @db.Text
  contactMethod  String?   @map("contact_method") @db.VarChar(30) // phone | wechat | email | store | other
  nextFollowUpAt DateTime? @map("next_follow_up_at")
  createdBy      Int?      @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  creator User? @relation("Creator", fields: [createdBy], references: [id])

  @@index([leadType, leadId])
  @@map("lead_follow_ups")
}

// ========== 统一行为事件采集 ==========

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  eventName  String   @db.VarChar(50)
  occurredAt DateTime @default(now()) @map("occurred_at")
  pagePath   String?  @map("page_path") @db.VarChar(300)
  productId  Int?     @map("product_id")
  searchTerm String?  @map("search_term") @db.VarChar(200)
  source     String?  @db.VarChar(50)
  deviceType String?  @map("device_type") @db.VarChar(20)
  sessionId  String?  @map("session_id") @db.VarChar(100)
  customerId Int?     @map("customer_id")
  metadata   Json?

  @@index([eventName])
  @@index([occurredAt])
  @@index([sessionId])
  @@map("analytics_events")
}
