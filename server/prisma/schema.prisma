  contentHash             String             @map("content_hash") @db.Char(64)
  customerSnapshot        Json?              @map("customer_snapshot")
  designFileVersionId     Int?               @map("design_file_version_id")
  partnerPriceAgreementId Int?               @map("partner_price_agreement_id")
  createdBy               Int?               @map("created_by")
  issuedAt                DateTime?          @map("issued_at")
  acceptedByCustomerId    Int?               @map("accepted_by_customer_id")
  acceptedAt              DateTime?          @map("accepted_at")
  createdAt               DateTime           @default(now()) @map("created_at")

  quotation             Quotation                     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  designFileVersion     CooperationDesignFileVersion? @relation(fields: [designFileVersionId], references: [id], onDelete: Restrict)
  partnerPriceAgreement PartnerPriceAgreement?        @relation(fields: [partnerPriceAgreementId], references: [id], onDelete: Restrict)
  creator               User?                         @relation("QuotationVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  acceptedByCustomer    Customer?                     @relation("QuotationVersionAcceptedByCustomer", fields: [acceptedByCustomerId], references: [id], onDelete: SetNull)
  items                 QuotationVersionItem[]
  paymentPlans          PaymentPlan[]
  convertedOrder        Order?                        @relation("QuotationVersionConvertedOrder")

  @@unique([quotationId, version])
  @@index([status, validUntil])
  @@index([partnerPriceAgreementId])
  @@map("quotation_versions")
}

model QuotationVersionItem {
  id                 Int      @id @default(autoincrement())
  quotationVersionId Int      @map("quotation_version_id")
  productId          Int?     @map("product_id")
  skuId              Int?     @map("sku_id")
  waxType            WaxType? @map("wax_type")
  description        String   @db.VarChar(500)
  quantity           Int      @default(1)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  subtotal           Decimal  @db.Decimal(12, 2)
  pricingSnapshot    Json     @map("pricing_snapshot")

  quotationVersion QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku              ProductSKU?      @relation(fields: [skuId], references: [id], onDelete: SetNull)

  @@index([quotationVersionId])
  @@map("quotation_version_items")
}

model PaymentPlan {
  id                 Int               @id @default(autoincrement())
  quotationVersionId Int?              @unique @map("quotation_version_id")
  orderId            Int?              @unique @map("order_id")
  currency           String            @default("CNY") @db.Char(3)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(12, 2)
  status             PaymentPlanStatus @default(DRAFT)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  quotationVersion QuotationVersion?        @relation(fields: [quotationVersionId], references: [id], onDelete: Restrict)
  order            Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  installments     PaymentPlanInstallment[]

  @@index([quotationVersionId])
  @@index([orderId])
  @@map("payment_plans")
}

model PaymentPlanInstallment {
  id            Int                      @id @default(autoincrement())
  paymentPlanId Int                      @map("payment_plan_id")
  sequence      Int
  label         String                   @db.VarChar(100)
  amount        Decimal                  @db.Decimal(12, 2)
  dueAt         DateTime?                @map("due_at")
  status        PaymentInstallmentStatus @default(PENDING)
  paidAt        DateTime?                @map("paid_at")
  paymentId     Int?                     @unique @map("payment_id")
  createdAt     DateTime                 @default(now()) @map("created_at")

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  payment     Payment?    @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentPlanId, sequence])
  @@index([status, dueAt])
  @@map("payment_plan_installments")
}

model LogisticsEvent {
  id             Int                  @id @default(autoincrement())
  orderId        Int                  @map("order_id")
  fulfillmentId  Int?                 @map("fulfillment_id")
  source         LogisticsEventSource
  carrierCode    String?              @map("carrier_code") @db.VarChar(50)
  trackingNoHash String?              @map("tracking_no_hash") @db.Char(64)
  eventCode      String               @map("event_code") @db.VarChar(80)
  description    String               @db.VarChar(500)
  location       String?              @db.VarChar(200)
  occurredAt     DateTime             @map("occurred_at")
  externalId     String?              @map("external_id") @db.VarChar(150)
  rawPayload     Json?                @map("raw_payload")
  createdAt      DateTime             @default(now()) @map("created_at")

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment Fulfillment? @relation(fields: [fulfillmentId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([orderId, occurredAt])
  @@map("logistics_events")
}

model SeoSnapshot {
  id                 Int           @id @default(autoincrement())
  pageLocalizationId Int?          @map("page_localization_id")
  productId          Int?          @map("product_id")
  locale             ContentLocale
  routePath          String        @map("route_path") @db.VarChar(500)
  title              String        @db.VarChar(200)
  description        String?       @db.VarChar(500)
  canonicalUrl       String        @map("canonical_url") @db.VarChar(500)
  robots             String        @default("index,follow") @db.VarChar(100)
  structuredData     Json?         @map("structured_data")
  contentHash        String        @map("content_hash") @db.Char(64)
  generatedAt        DateTime      @default(now()) @map("generated_at")
  publishedAt        DateTime?     @map("published_at")

  pageLocalization PageDocumentLocalization? @relation(fields: [pageLocalizationId], references: [id], onDelete: Cascade)
  product          Product?                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locale, routePath, contentHash])
  @@index([pageLocalizationId, publishedAt])
  @@index([productId, locale, publishedAt])
  @@map("seo_snapshots")
}
