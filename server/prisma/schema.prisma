  lead     Lead?

  @@index([status])
  @@index([customerId, createdAt])
  @@index([createdAt]) // dashboard 今日询价计数
  @@map("inquiries")
}

enum InquiryStatus {
  PENDING // 待处理
  PROCESSING // 处理中
  REPLIED // 已回复
  CLOSED // 已关闭
}

