generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========== 用户与权限 ==========

model User {
  id          Int       @id @default(autoincrement())
  username    String    @unique @db.VarChar(50)
  password    String    @db.VarChar(255)
  realName    String?   @map("real_name") @db.VarChar(50)
  phone       String?   @db.VarChar(20)
  email       String?   @db.VarChar(100)
  avatar      String?   @db.VarChar(500)
  role        Role      @default(EDITOR)
  status      Status    @default(ACTIVE)
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  operationLogs             OperationLog[]
  aiClassifyRecords         AIClassifyRecord[]             @relation("Operator")
  inquiries                 Inquiry[]                      @relation("AssignedTo")
  Order                     Order[]
  selectionInquiries        SelectionInquiry[]             @relation("Handler")
  leadFollowUps             LeadFollowUp[]                 @relation("Creator")
  assignedLeads             Lead[]                         @relation("LeadAssignee")
  leadActivities            LeadActivity[]                 @relation("LeadActivityCreator")
  leadLegalHolds            Lead[]                         @relation("LeadLegalHoldActor")
  leadPrivacyDispositions   Lead[]                         @relation("LeadPrivacyDispositionActor")
  // 交易域审核/执行人关联（命名关系，避免与既有 User 关系冲突）
  paymentReviews            Payment[]                      @relation("PaymentReviewer")
  refundRequests            Refund[]                       @relation("RefundRequester")
  refundReviews             Refund[]                       @relation("RefundReviewer")
  refundProcessings         Refund[]                       @relation("RefundProcessor")
  fulfillmentCreators       Fulfillment[]                  @relation("FulfillmentCreator")
  afterSalesHandlers        AfterSalesCase[]               @relation("AfterSalesHandler")
  // 合作申请审核人关联（命名关系，避免与既有 User 关系冲突）
  partnerApplicationReviews PartnerApplication[]           @relation("PartnerApplicationReviewer")
  // 交易中心：销售顾问关联的订单与报价单
  salesConsultantOrders     Order[]                        @relation("OrderSalesConsultant")
  quotationsAsConsultant    Quotation[]                    @relation("QuotationSalesConsultant")
  adminRefreshSessions      AdminRefreshSession[]
  uploadedMediaAssets       MediaAsset[]                   @relation("MediaAssetUploader")
  submittedPageLocales      PageDocumentLocalization[]     @relation("PageLocaleSubmitter")
  reviewedPageLocales       PageDocumentLocalization[]     @relation("PageLocaleReviewer")
  publishedPageLocales      PageDocumentLocalization[]     @relation("PageLocalePublisher")
  reviewedPriceApplications PartnerPriceApplication[]      @relation("PartnerPriceApplicationReviewer")
  createdPriceAgreements    PartnerPriceAgreement[]        @relation("PartnerPriceAgreementCreator")
  createdQuotationVersions  QuotationVersion[]             @relation("QuotationVersionCreator")
  createdDesignFileVersions CooperationDesignFileVersion[] @relation("DesignFileVersionCreator")
  personalContentTemplates  PersonalContentTemplate[]
  ownedDynamicTemplates     DynamicTemplate[]              @relation("DynamicTemplateOwner")
  updatedDynamicDrafts      DynamicTemplateDraft[]         @relation("DynamicTemplateDraftUpdater")
  publishedDynamicVersions  DynamicTemplateVersion[]       @relation("DynamicTemplateVersionPublisher")
  activatedDynamicTemplates DynamicTemplateActivation[]    @relation("DynamicTemplateActivationActor")

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CUSTOMER_SERVICE
  WAREHOUSE
  SALES_CONSULTANT // 销售顾问：创建报价、查看自己客户订单
  FINANCE // 财务：确认收款、处理退款
}

enum Status {
  ACTIVE
  DISABLED
}

// ========== 分类管理（四级自关联） ==========

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(150)
  level       Int       @default(1) // 1-4
  parentId    Int?      @map("parent_id")
  icon        String?   @db.VarChar(500)
  coverImage  String?   @map("cover_image") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  seoTitle    String?   @map("seo_title") @db.VarChar(200)
  seoDesc     String?   @map("seo_desc") @db.VarChar(500)
  seoKeywords String?   @map("seo_keywords") @db.VarChar(300)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") // 软删除标记
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  products     Product[]
  translations CategoryTranslation[]

  @@map("categories")
}

// ========== 产品管理（核心） ==========

model Product {
  id                          Int                             @id @default(autoincrement())
  code                        String                          @unique @db.VarChar(50) // 产品编码/货号
  name                        String                          @db.VarChar(200)
  shortDescription            String?                         @map("short_description") @db.VarChar(500) // 简介
  description                 String?                         @db.Text
  categoryId                  Int                             @map("category_id")
  materialType                MaterialType                    @default(GOLD_999) @map("material_type")
  goldWeight                  Decimal?                        @default(0) @map("gold_weight") @db.Decimal(8, 2) // 金重(g)
  craftFee                    Decimal?                        @default(0) @map("craft_fee") @db.Decimal(10, 2) // 工费
  price                       Decimal?                        @default(0) @db.Decimal(10, 2) // 有效且有价 SKU 的派生最低价缓存，禁止作为成交价事实源
  priceMin                    Decimal?                        @default(0) @map("price_min") @db.Decimal(10, 2)
  priceMax                    Decimal?                        @default(0) @map("price_max") @db.Decimal(10, 2)
  weight                      Decimal?                        @default(0) @db.Decimal(8, 2) // 总重量(g)
  size                        String?                         @db.VarChar(100) // 尺寸规格
  gemInfo                     Json?                           @map("gem_info") // 宝石信息JSON
  craftTechnique              Json?                           @map("craft_technique") // 工艺技法JSON
  detailContent               Json?                           @map("detail_content") // 模块化详情：图片/文字块
  status                      ProductStatus                   @default(DRAFT)
  publicationQualityStatus    ProductPublicationQualityStatus @default(QUARANTINED) @map("publication_quality_status")
  publicationQualityHash      String?                         @map("publication_quality_hash") @db.Char(64)
  publicationQualityCheckedAt DateTime?                       @map("publication_quality_checked_at")
  // 商品可见范围分级（受控产品库核心字段）
  // PUBLIC=公开宣传款（本期不迁移旧商品到此）；MEMBER=登录会员可见（默认）；
  // PARTNER=仅审核通过的合作商家可见；INTERNAL=仅后台员工可见，前台永不展示。
  visibility                  ProductVisibility               @default(MEMBER)
  salesMode                   SalesMode                       @default(DISPLAY_ONLY) @map("sales_mode")
  inventoryPolicy             InventoryPolicy                 @default(STANDARD) @map("inventory_policy")
  purchaseRegion              ProductPurchaseRegion           @default(MAINLAND) @map("purchase_region")
  publishMode                 ProductPublishMode              @default(WAREHOUSE) @map("publish_mode")
  scheduledPublishAt          DateTime?                       @map("scheduled_publish_at")
  scheduledPublishError       String?                         @map("scheduled_publish_error") @db.VarChar(500)
  fulfillmentType             ProductFulfillmentType          @default(IN_STOCK) @map("fulfillment_type")
  dispatchTime                ProductDispatchTime             @default(WITHIN_48_HOURS) @map("dispatch_time")
  shippingTemplateId          Int?                            @map("shipping_template_id")
  deliveryMethods             Json?                           @map("delivery_methods")
  requiresInsuredShipping     Boolean                         @default(true) @map("requires_insured_shipping")
  requiresSignature           Boolean                         @default(true) @map("requires_signature")
  includesCertificate         Boolean                         @default(true) @map("includes_certificate")
  packageType                 String?                         @map("package_type") @db.VarChar(100)
  customLeadTime              String?                         @map("custom_lead_time") @db.VarChar(100)
  sortOrder                   Int                             @default(0) @map("sort_order")
  isHot                       Boolean                         @default(false) @map("is_hot")
  isNew                       Boolean                         @default(false) @map("is_new")
  isRecommended               Boolean                         @default(false) @map("is_recommended")
  isLimited                   Boolean                         @default(false) @map("is_limited")
  isCustom                    Boolean                         @default(false) @map("is_custom")
  multiDiscount               Boolean                         @default(false) @map("multi_discount")
  viewCount                   Int                             @default(0) @map("view_count")
  salesCount                  Int                             @default(0) @map("sales_count")
  publishedAt                 DateTime?                       @map("published_at")
  deletedAt                   DateTime?                       @map("deleted_at")
  createdAt                   DateTime                        @default(now()) @map("created_at")
  updatedAt                   DateTime                        @updatedAt @map("updated_at")

  category               Category                @relation(fields: [categoryId], references: [id])
  images                 ProductImage[]
  primaryImageId         Int?                    @map("primary_image_id")
  listingImageId         Int?                    @map("listing_image_id")
  primaryImage           ProductImage?           @relation("PrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  listingImage           ProductImage?           @relation("ListingImage", fields: [listingImageId], references: [id], onDelete: SetNull)
  skus                   ProductSKU[]
  tags                   ProductTag[]
  productAttributes      ProductAttributeValue[]
  certificates           Certificate[]
  inquiries              Inquiry[]
  favorites              CustomerFavorite[]
  reviews                ProductReview[]
  orderItems             OrderItem[]
  cartItems              Cart[]
  selectionInquiryItems  SelectionInquiryItem[]
  accessLogs             ProductAccessLog[]
  quotationItems         QuotationItem[]
  shippingTemplate       ShippingTemplate?       @relation(fields: [shippingTemplateId], references: [id], onDelete: SetNull)
  translations           ProductTranslation[]
  cooperationDesignFiles CooperationDesignFile[]
  seoSnapshots           SeoSnapshot[]
  quotationVersionItems  QuotationVersionItem[]

  @@index([categoryId])
  @@index([status])
  @@index([materialType])
  @@index([isHot])
  @@index([categoryId, status]) // 复合索引：按分类+状态查询
  @@index([status, visibility]) // 受控目录：按状态+可见范围过滤
  @@index([status, visibility, publicationQualityStatus], map: "products_publication_quality_idx")
  @@index([categoryId, status, visibility]) // 分类目录组合查询
  @@index([visibility])
  @@index([deletedAt]) // 软删除过滤
  @@index([publishMode, scheduledPublishAt])
  @@index([shippingTemplateId])
  @@map("products")
}

enum MaterialType {
  GOLD_999 // 足金999
  GOLD_9999 // 足金9999
  AU750 // K金
  PT950 // 铂金
  S925 // 银
  DIAMOND // 镶钻
  JADE // 玉石
  PEARL // 珍珠
  COLOR_GEM // 彩宝
  OTHER
}

enum ProductStatus {
  DRAFT // 草稿
  PUBLISHED // 已发布(上架)
  OFFLINE // 已下架
  ARCHIVED // 已归档
}

// 公开商品必须通过当前内容、材质、媒体与销售模式门禁；旧数据默认隔离。
enum ProductPublicationQualityStatus {
  QUARANTINED
  READY
}

// 商品可见范围分级（受控产品库）
enum ProductVisibility {
  PUBLIC // 公开宣传款（本期不迁移旧商品到此，保留给未来运营）
  MEMBER // 登录会员可见（默认）
  PARTNER // 仅审核通过的合作商家可见
  INTERNAL // 仅后台员工可见，前台永不展示
}

enum SalesMode {
  DISPLAY_ONLY // 仅展示
  SELECTION // 选款模式
  APPOINTMENT // 预约模式
  DIRECT_PURCHASE // 直接购买(暂未开放)
  CUSTOM_INQUIRY // 定制咨询
}

enum InventoryPolicy {
  STANDARD // 普通商品，库存和购买数量按现有规则管理
  SINGLE_UNIT // 一物一件：一个有效 SKU，库存总量与购买数量均不超过 1
}

enum ProductPurchaseRegion {
  MAINLAND
  CROSS_BORDER
}

enum ProductPublishMode {
  IMMEDIATE
  SCHEDULED
  WAREHOUSE
}

enum ProductFulfillmentType {
  IN_STOCK
  PREORDER
  CUSTOM
}

enum ProductDispatchTime {
  SAME_DAY
  WITHIN_24_HOURS
  WITHIN_48_HOURS
  OVER_48_HOURS
  CUSTOM
}

model ShippingTemplate {
  id                    Int             @id @default(autoincrement())
  name                  String          @db.VarChar(100)
  carrier               String?         @db.VarChar(100)
  feeMode               ShippingFeeMode @default(FREE) @map("fee_mode")
  baseFee               Decimal         @default(0) @map("base_fee") @db.Decimal(10, 2)
  remoteSurcharge       Decimal         @default(0) @map("remote_surcharge") @db.Decimal(10, 2)
  freeShippingThreshold Decimal?        @map("free_shipping_threshold") @db.Decimal(10, 2)
  excludedRegions       Json?           @map("excluded_regions")
  insured               Boolean         @default(true)
  signatureRequired     Boolean         @default(true) @map("signature_required")
  isDefault             Boolean         @default(false) @map("is_default")
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("shipping_templates")
}

enum ShippingFeeMode {
  FREE
  FIXED
  CONDITIONAL
}

// ========== 产品图片（三视图） ==========

model ProductImage {
  id            Int       @id @default(autoincrement())
  productId     Int       @map("product_id")
  url           String    @db.VarChar(500)
  // 受控媒体安全存储标识：仅保存相对 private-media/products 的安全键。
  // 客户商品接口不得返回真实磁盘路径或 storageKey，仅返回受保护的媒体端点信息。
  storageKey    String?   @map("storage_key") @db.VarChar(300)
  type          ImageType @default(FRONT) // 正面/侧面/顶部/视频
  sortOrder     Int       @default(0) @map("sort_order")
  isVideo       Boolean   @default(false) @map("is_video")
  sourceImageId Int?      @map("source_image_id")
  cropData      Json?     @map("crop_data")
  width         Int?
  height        Int?
  mimeType      String?   @map("mime_type") @db.VarChar(50)
  fileSize      Int?      @map("file_size")
  createdAt     DateTime  @default(now()) @map("created_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceImage   ProductImage?  @relation("SourceImage", fields: [sourceImageId], references: [id], onDelete: SetNull)
  derivedImages ProductImage[] @relation("SourceImage")
  primaryOf     Product[]      @relation("PrimaryImage")
  listingOf     Product[]      @relation("ListingImage")
  mediaAssetId  Int?           @map("media_asset_id")
  mediaAsset    MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@map("product_images")
}

enum ImageType {
  FRONT
  SIDE
  TOP
  DETAIL
  WEARING
}

// ========== 产品SKU ==========

model ProductSKU {
  id          Int          @id @default(autoincrement())
  productId   Int          @map("product_id")
  skuCode     String       @unique @map("sku_code") @db.VarChar(100)
  material    MaterialType @default(GOLD_999)
  size        String?      @db.VarChar(50)
  goldWeight  Decimal?     @map("gold_weight") @db.Decimal(8, 2)
  price       Decimal      @default(0) @db.Decimal(10, 2) // DIRECT_PURCHASE 唯一成交价事实源
  stock       Int          @default(0) // @deprecated 库存请通过 InventoryService 统一管理
  safetyStock Int          @default(5) @map("safety_stock")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventories           Inventory[]
  orderItems            OrderItem[]
  cartItems             Cart[]
  reservations          InventoryReservation[]
  quotationItems        QuotationItem[]
  quotationVersionItems QuotationVersionItem[]

  @@map("product_skus")
}

// ========== 标签字典 + 产品标签关联 ==========

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  slug      String   @unique @db.VarChar(80)
  group     String?  @db.VarChar(50) // 标签分组（如：工艺、寓意、场景）
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productTags ProductTag[]

  @@map("tags")
}

model ProductTag {
  id        Int @id @default(autoincrement())
  productId Int @map("product_id")
  tagId     Int @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ========== 商品属性字典（Attribute / AttributeValue） ==========

model Attribute {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(50)
  name         String   @db.VarChar(50)
  sortOrder    Int      @default(0) @map("sort_order")
  isFilterable Boolean  @default(true) @map("is_filterable")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  values AttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          Int     @id @default(autoincrement())
  attributeId Int     @map("attribute_id")
  value       String  @db.VarChar(100)
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  attribute         Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttributeValue[]

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductAttributeValue {
  id               Int @id @default(autoincrement())
  productId        Int @map("product_id")
  attributeValueId Int @map("attribute_value_id")

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeValueId])
  @@map("product_attribute_values")
}

// ========== 产品证书 ==========

model Certificate {
  id         Int       @id @default(autoincrement())
  productId  Int       @map("product_id")
  certType   CertType  @map("cert_type")
  certNumber String    @map("cert_number") @db.VarChar(100)
  certImage  String?   @map("cert_image") @db.VarChar(500)
  expireDate DateTime? @map("expire_date")
  createdAt  DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

enum CertType {
  NATIONAL // 国检
  PROVINCIAL // 省检
  GIA // GIA
  OTHER
}

// ========== 金价管理 ==========

model GoldPrice {
  id         Int             @id @default(autoincrement())
  price      Decimal         @db.Decimal(10, 2) // 每克金价(元)
  source     GoldPriceSource @default(AUTO)
  operatorId Int?            @map("operator_id") // 手动录入时的操作人
  remark     String?         @db.VarChar(500)
  recordDate DateTime        @default(now()) @map("record_date")
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([recordDate])
  @@map("gold_prices")
}

enum GoldPriceSource {
  AUTO
  MANUAL
}

// ========== 库存管理 ==========

model Warehouse {
  id         Int           @id @default(autoincrement())
  name       String        @db.VarChar(100)
  type       WarehouseType
  address    String?       @db.VarChar(300)
  contact    String?       @db.VarChar(50)
  phone      String?       @db.VarChar(20)
  isActive   Boolean       @default(true) @map("is_active")
  isDefault  Boolean       @default(false) @map("is_default")
  defaultKey String?       @unique @map("default_key") @db.VarChar(20)
  createdAt  DateTime      @default(now()) @map("created_at")

  inventories  Inventory[]
  fulfillments Fulfillment[]

  @@map("warehouses")
}

enum WarehouseType {
  SHOWROOM // 展厅
  FACTORY // 工厂
  STORE // 门店
}

model Inventory {
  id          Int       @id @default(autoincrement())
  skuId       Int       @map("sku_id")
  warehouseId Int       @map("warehouse_id")
  quantity    Int       @default(0)
  safetyStock Int       @default(5) @map("safety_stock")
  lastCheckAt DateTime? @map("last_check_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sku          ProductSKU             @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id])
  reservations InventoryReservation[]

  @@unique([skuId, warehouseId])
  @@map("inventories")
}

// ========== 订单管理 ==========

model Order {
  id                      Int         @id @default(autoincrement())
  orderNo                 String      @unique @map("order_no") @db.VarChar(30)
  userId                  Int?        @map("user_id") // 关联注册用户（可选，兼容游客下单）
  customerName            String      @map("customer_name") @db.VarChar(50)
  customerId              Int?        @map("customer_id")
  customerPhone           String      @map("customer_phone") @db.VarChar(20)
  customerEmail           String?     @map("customer_email") @db.VarChar(100)
  address                 String      @db.VarChar(500)
  totalAmount             Decimal     @map("total_amount") @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0) @map("discount_amount") @db.Decimal(10, 2)
  shippingAmount          Decimal     @default(0) @map("shipping_amount") @db.Decimal(10, 2)
  insuranceAmount         Decimal     @default(0) @map("insurance_amount") @db.Decimal(10, 2)
  taxAmount               Decimal     @default(0) @map("tax_amount") @db.Decimal(10, 2)
  finalAmount             Decimal     @map("final_amount") @db.Decimal(12, 2)
  currency                String      @default("CNY") @db.Char(3)
  shippingAddressSnapshot Json        @map("shipping_address_snapshot")
  pricingSnapshot         Json        @map("pricing_snapshot")
  status                  OrderStatus @default(PENDING_PAYMENT)
  paymentMethod           String?     @map("payment_method") @db.VarChar(50)
  paymentProof            String?     @map("payment_proof") @db.VarChar(500)
  logisticsCompany        String?     @map("logistics_company") @db.VarChar(50)
  logisticsNo             String?     @map("logistics_no") @db.VarChar(100)
  internalNote            String?     @map("internal_note") @db.Text
  lockedGoldPrice         Decimal?    @map("locked_gold_price") @db.Decimal(10, 2)
  reservedAt              DateTime?   @map("reserved_at")
  paymentConfirmedAt      DateTime?   @map("payment_confirmed_at")
  shippedAt               DateTime?   @map("shipped_at")
  completedAt             DateTime?   @map("completed_at")
  cancelledAt             DateTime?   @map("cancelled_at")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  // 交易中心扩展字段（订单类型 / 销售顾问 / 来源 / 定金尾款 / 已收已退 / 定制阶段 / 发货维度）
  orderType         OrderType      @default(SPOT) @map("order_type")
  salesConsultantId Int?           @map("sales_consultant_id")
  source            String?        @db.VarChar(50) // 来源渠道：website/store/wechat/referral/offline
  adjustmentAmount  Decimal        @default(0) @map("adjustment_amount") @db.Decimal(10, 2) // 订单调整（手工调价/抹零）
  depositAmount     Decimal        @default(0) @map("deposit_amount") @db.Decimal(10, 2) // 应付定金
  paidDeposit       Decimal        @default(0) @map("paid_deposit") @db.Decimal(10, 2) // 已付定金
  balanceAmount     Decimal        @default(0) @map("balance_amount") @db.Decimal(10, 2) // 应付尾款
  paidBalance       Decimal        @default(0) @map("paid_balance") @db.Decimal(10, 2) // 已付尾款
  paidAmount        Decimal        @default(0) @map("paid_amount") @db.Decimal(12, 2) // 已收总额（审核通过时同步）
  refundedAmount    Decimal        @default(0) @map("refunded_amount") @db.Decimal(12, 2) // 已退款总额
  customStage       CustomStage?   @map("custom_stage") // 定制订单专属阶段（仅 orderType=CUSTOM 使用）
  deliveryStatus    DeliveryStatus @default(NONE) @map("delivery_status") // 发货维度独立状态
  receivedAt        DateTime?      @map("received_at") // 签收时间

  items              OrderItem[]
  payments           Payment[]
  refunds            Refund[]
  reviews            ProductReview[]
  reservations       InventoryReservation[]
  // 交易域扩展：履约、售后、不可变事件时间线
  fulfillments       Fulfillment[]
  afterSalesCases    AfterSalesCase[]
  tradeEvents        TradeEvent[]
  paymentPlans       PaymentPlan[]
  logisticsEvents    LogisticsEvent[]
  quotationVersionId Int?                   @unique @map("quotation_version_id")
  user               User?                  @relation(fields: [userId], references: [id])
  customer           Customer?              @relation(fields: [customerId], references: [id])
  couponId           Int?                   @map("coupon_id")
  // 交易中心关系
  salesConsultant    User?                  @relation("OrderSalesConsultant", fields: [salesConsultantId], references: [id], onDelete: SetNull)
  quotationSource    Quotation?             @relation("QuotationConvertedOrder") // 该订单由哪张报价单转出（一对一，外键在 Quotation.convertedOrderId）
  quotationVersion   QuotationVersion?      @relation("QuotationVersionConvertedOrder", fields: [quotationVersionId], references: [id], onDelete: Restrict)

  @@index([orderNo])
  @@index([status])
  @@index([customerPhone])
  @@index([customerPhone, createdAt]) // 复合索引：按手机+时间查订单
  @@index([userId, createdAt]) // 复合索引：按用户+时间查订单
  @@index([customerId, createdAt])
  @@index([createdAt]) // dashboard 今日订单计数 / orderTrend 按日聚合
  @@index([status, createdAt]) // 营收聚合：status in (...) + createdAt range
  @@index([orderType])
  @@index([salesConsultantId])
  @@index([deliveryStatus])
  @@map("orders")
}

model Customer {
  id                  Int                          @id @default(autoincrement())
  phone               String                       @unique @db.VarChar(20)
  name                String?                      @db.VarChar(50)
  email               String?                      @db.VarChar(100)
  passwordHash        String?                      @map("password_hash") @db.VarChar(255)
  status              Status                       @default(ACTIVE)
  // 微信开放平台扫码登录：openid 唯一绑定；unionid 同开放平台账号跨应用一致（未扫码绑定前为 NULL）
  wechatOpenId        String?                      @unique @map("wechat_open_id") @db.VarChar(64)
  wechatUnionId       String?                      @map("wechat_union_id") @db.VarChar(64)
  // 合作商家体系：客户合作权限状态，独立于后台 User.Role。
  // accountType=PARTNER 表示当前可访问 PARTNER 可见范围商品（仅 partnerStatus=APPROVED 时生效）。
  accountType         CustomerAccountType          @default(MEMBER) @map("account_type")
  partnerStatus       PartnerStatus                @default(NONE) @map("partner_status")
  partnerApprovedAt   DateTime?                    @map("partner_approved_at")
  lastOrderAt         DateTime?                    @map("last_order_at")
  passwordResetTokens CustomerPasswordResetToken[]
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  addresses                 CustomerAddress[]
  favorites                 CustomerFavorite[]
  reviews                   ProductReview[]
  orders                    Order[]
  inquiries                 Inquiry[]
  selectionInquiries        SelectionInquiry[]
  leads                     Lead[]
  afterSalesCases           AfterSalesCase[]
  partnerApplications       PartnerApplication[]
  productAccessLogs         ProductAccessLog[]
  quotations                Quotation[]
  customerRefreshSessions   CustomerRefreshSession[]
  consentRecords            ConsentRecord[]
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  partnerPriceApplications  PartnerPriceApplication[]
  partnerPriceAgreements    PartnerPriceAgreement[]
  cooperationDesignFiles    CooperationDesignFile[]
  confirmedDesignVersions   CooperationDesignFileVersion[] @relation("DesignFileVersionConfirmedByCustomer")
  acceptedQuotationVersions QuotationVersion[]             @relation("QuotationVersionAcceptedByCustomer")

  @@index([partnerStatus])
  @@map("customers")
}

// 客户密码重置令牌：只存 SHA-256 哈希（库泄露不泄露令牌本身），一次性使用，30 分钟过期
model CustomerPasswordResetToken {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_password_reset_tokens")
}

// 客户收藏（心愿单）：一人一作品唯一，删除商品时级联清理
model CustomerFavorite {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([productId])
  @@map("customer_favorites")
}

// 短信验证码（手机验真）：只存 SHA-256 哈希，5 分钟时效，一次性；60s 冷却与日上限由服务层约束
model CustomerSmsCode {
  id        Int       @id @default(autoincrement())
  phone     String    @db.VarChar(20)
  codeHash  String    @map("code_hash") @db.VarChar(64)
  purpose   String    @default("REGISTER") @db.VarChar(20)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("customer_sms_codes")
}

// 商品评价：仅已完成订单的关联客户可评；一人一单商品一条（防刷）；先审后展（品牌调性）
model ProductReview {
  id         Int       @id @default(autoincrement())
  productId  Int       @map("product_id")
  customerId Int       @map("customer_id")
  orderId    Int       @map("order_id")
  rating     Int // 1-5 星
  content    String    @db.Text
  images     Json? // 晒单图 URL 列表（string[]，公开上传管线，最多 6 张）
  status     String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | REJECTED
  reply      String?   @db.Text // 商家回复（后台填写，随评价一并展示）
  repliedAt  DateTime? @map("replied_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId, status])
  @@map("product_reviews")
}

// 客户账户类型：普通会员 / 审核通过的合作商家
enum CustomerAccountType {
  MEMBER
  PARTNER
}

// 合作申请生命周期状态（客户合作权限）
// NONE=未申请；PENDING=待审核；NEEDS_SUPPLEMENT=需补充资料；APPROVED=已通过；
// REJECTED=已驳回（可重新提交）；SUSPENDED=已暂停（即便旧 JWT 未过期也立即失去合作商品访问权）
enum PartnerStatus {
  NONE
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

// 合作申请审核状态（与 PartnerStatus 的审核段对齐，专门用于申请记录）
enum PartnerApplicationStatus {
  PENDING
  NEEDS_SUPPLEMENT
  APPROVED
  REJECTED
  SUSPENDED
}

// 商品访问审计事件类型（服务端可信记录，不依赖前端 AnalyticsEvent）
enum ProductAccessEventType {
  DETAIL_VIEW
  MEDIA_VIEW
  RECOMMENDATION_IMPRESSION
  ADD_TO_SELECTION
  ADD_TO_CART
  INQUIRY_SUBMITTED
  ORDER_COMPLETED
}

model CustomerAddress {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  recipientName  String   @map("recipient_name") @db.VarChar(50)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  province       String?  @db.VarChar(50)
  city           String?  @db.VarChar(50)
  district       String?  @db.VarChar(50)
  detail         String   @db.VarChar(300)
  postalCode     String?  @map("postal_code") @db.VarChar(20)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

enum OrderStatus {
  PENDING_PAYMENT // 待付款
  PENDING_SHIP // 待发货
  SHIPPED // 已发货
  COMPLETED // 已完成
  CANCELLED // 已取消
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int      @map("order_id")
  skuId                Int      @map("sku_id")
  productId            Int      @map("product_id")
  quantity             Int      @default(1)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal             Decimal  @db.Decimal(10, 2)
  // 成交快照 — 商品后续修改不影响历史订单
  productNameSnapshot  String?  @map("product_name_snapshot") @db.VarChar(200)
  productImageSnapshot String?  @map("product_image_snapshot") @db.VarChar(500)
  productCodeSnapshot  String?  @map("product_code_snapshot") @db.VarChar(50)
  skuSnapshot          String?  @map("sku_snapshot") @db.VarChar(200)
  actualWeight         Decimal? @map("actual_weight") @db.Decimal(8, 2)
  certNumber           String?  @map("cert_number") @db.VarChar(100)

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku              ProductSKU        @relation(fields: [skuId], references: [id])
  product          Product           @relation(fields: [productId], references: [id])
  fulfillmentItems FulfillmentItem[]
  afterSalesCases  AfterSalesCase[]

  @@unique([orderId, skuId])
  @@map("order_items")
}

// 库存预占明细：记录订单锁定的具体仓位，供支付确认、取消和超时释放使用。
model InventoryReservation {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  inventoryId Int?      @map("inventory_id")
  skuId       Int       @map("sku_id")
  quantity    Int
  expiresAt   DateTime  @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory       Inventory?       @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  sku             ProductSKU       @relation(fields: [skuId], references: [id], onDelete: Restrict)
  fulfillmentItem FulfillmentItem?

  @@index([orderId])
  @@index([inventoryId])
  @@index([skuId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

// ========== 支付管理 ==========

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int           @map("order_id")
  paymentNo      String        @unique @map("payment_no") @db.VarChar(50)
  amount         Decimal       @db.Decimal(12, 2)
  method         String        @db.VarChar(30) // wechat | alipay | bank_transfer | store
  status         PaymentStatus @default(PENDING)
  type           String        @default("FULL") @db.VarChar(20) // DEPOSIT | BALANCE | FULL
  gatewayTradeNo String?       @unique @map("gateway_trade_no") @db.VarChar(100)
  gatewayNotify  Json?         @map("gateway_notify")
  proofUrl       String?       @map("proof_url") @db.VarChar(500)
  reviewedBy     Int?          @map("reviewed_by")
  reviewedAt     DateTime?     @map("reviewed_at")
  reviewNote     String?       @map("review_note") @db.VarChar(500)
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  order       Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds     Refund[]
  reviewer    User?                   @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  installment PaymentPlanInstallment?

  @@index([orderId])
  @@index([paymentNo])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

// ========== 退款管理 ==========

model Refund {
  id               Int          @id @default(autoincrement())
  orderId          Int          @map("order_id")
  paymentId        Int?         @map("payment_id")
  refundNo         String       @unique @map("refund_no") @db.VarChar(50)
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?      @db.VarChar(500)
  status           RefundStatus @default(PENDING)
  gatewayRefundNo  String?      @unique @map("gateway_refund_no") @db.VarChar(100)
  processedAt      DateTime?    @map("processed_at")
  // 退款审核与执行链路（P2 扩展）：申请→审核→人工执行→完成/拒绝
  requestedBy      Int?         @map("requested_by") // 申请人（管理员 id）
  reviewedBy       Int?         @map("reviewed_by") // 审核人（管理员 id）
  reviewedAt       DateTime?    @map("reviewed_at")
  reviewNote       String?      @map("review_note") @db.VarChar(500)
  processedBy      Int?         @map("processed_by") // 实际执行人（管理员 id）
  completedAt      DateTime?    @map("completed_at")
  // 幂等键：防重复提交/重复执行（P2）；本阶段人工执行，预留第三方回调幂等
  idempotencyKey   String?      @unique @map("idempotency_key") @db.VarChar(64)
  afterSalesCaseId Int?         @map("after_sales_case_id")
  createdAt        DateTime     @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment        Payment?        @relation(fields: [paymentId], references: [id])
  requester      User?           @relation("RefundRequester", fields: [requestedBy], references: [id])
  reviewer       User?           @relation("RefundReviewer", fields: [reviewedBy], references: [id])
  processor      User?           @relation("RefundProcessor", fields: [processedBy], references: [id])
  afterSalesCase AfterSalesCase? @relation(fields: [afterSalesCaseId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([paymentId])
  @@map("refunds")
}

enum RefundStatus {
  PENDING // 待审核
  APPROVED // 审核通过，待执行
  PROCESSING // 执行中
  COMPLETED // 已完成
  REJECTED // 已拒绝
  FAILED // 执行失败
}

// ========== 交易事件（不可变时间线）==========
// 每个交易写操作必须追加一条事件；订单详情按时间线展示完整历史。
// 事件一旦写入只读，禁止更新/删除（软删除亦不允许）。
model TradeEvent {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  entityType   String   @map("entity_type") @db.VarChar(30) // ORDER | PAYMENT | REFUND | FULFILLMENT | AFTER_SALES | INVENTORY
  entityId     Int      @map("entity_id")
  eventType    String   @map("event_type") @db.VarChar(40)
  fromStatus   String?  @map("from_status") @db.VarChar(30)
  toStatus     String?  @map("to_status") @db.VarChar(30)
  operatorType String   @map("operator_type") @db.VarChar(20) // CUSTOMER | ADMIN | SYSTEM
  operatorId   Int?     @map("operator_id")
  operatorName String?  @map("operator_name") @db.VarChar(50)
  reason       String?  @db.VarChar(500)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([entityType, entityId])
  @@index([eventType])
  @@map("trade_events")
}

// ========== 履约（拣货→复核→发货→送达）==========
// MVP 一单一包裹：一个 Order 通常对应一个 Fulfillment。
// 模型已为一单多包裹预留：同一 orderId 可有多行，每行=一个包裹。
model Fulfillment {
  id             Int               @id @default(autoincrement())
  fulfillmentNo  String            @unique @map("fulfillment_no") @db.VarChar(50)
  orderId        Int               @map("order_id")
  warehouseId    Int               @map("warehouse_id")
  status         FulfillmentStatus @default(PENDING_PICK)
  carrier        String?           @db.VarChar(50) // 承运商
  trackingNo     String?           @map("tracking_no") @db.VarChar(100) // 运单号
  shippedAt      DateTime?         @map("shipped_at")
  deliveredAt    DateTime?         @map("delivered_at")
  abnormalReason String?           @map("abnormal_reason") @db.VarChar(500) // 物流异常原因
  internalNote   String?           @map("internal_note") @db.Text
  createdBy      Int?              @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creator         User?             @relation("FulfillmentCreator", fields: [createdBy], references: [id])
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items           FulfillmentItem[]
  logisticsEvents LogisticsEvent[]

  @@unique([orderId, warehouseId])
  @@index([status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id                     Int @id @default(autoincrement())
  fulfillmentId          Int @map("fulfillment_id")
  orderItemId            Int @map("order_item_id")
  inventoryReservationId Int @unique @map("inventory_reservation_id")
  quantity               Int

  fulfillment          Fulfillment          @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItem            OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  inventoryReservation InventoryReservation @relation(fields: [inventoryReservationId], references: [id], onDelete: Restrict)

  @@index([fulfillmentId])
  @@index([orderItemId])
  @@map("fulfillment_items")
}

enum FulfillmentStatus {
  PENDING_PICK // 待拣货
  PENDING_CHECK // 待复核
  PENDING_SHIP // 待发货
  SHIPPED // 已发货
  DELIVERED // 已送达
  ABNORMAL // 物流异常
}

// ========== 售后工单（退款退货 / 换货 / 维修）==========
// 售后 ≠ 退款：售后审核通过后可发起退款（关联 Refund），也可仅换货/维修。
model AfterSalesCase {
  id                    Int              @id @default(autoincrement())
  caseNo                String           @unique @map("case_no") @db.VarChar(50)
  orderId               Int              @map("order_id")
  orderItemId           Int?             @map("order_item_id")
  customerId            Int?             @map("customer_id")
  type                  AfterSalesType
  status                AfterSalesStatus @default(REQUESTED)
  reason                String           @db.VarChar(500)
  evidenceUrls          Json?            @map("evidence_urls")
  customerNote          String?          @map("customer_note") @db.Text
  adminNote             String?          @map("admin_note") @db.Text
  requestedRefundAmount Decimal?         @map("requested_refund_amount") @db.Decimal(12, 2)
  approvedRefundAmount  Decimal?         @map("approved_refund_amount") @db.Decimal(12, 2)
  handledBy             Int?             @map("handled_by")
  handledAt             DateTime?        @map("handled_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  handler   User?      @relation("AfterSalesHandler", fields: [handledBy], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  refunds   Refund[]

  @@index([orderId])
  @@index([status])
  @@index([customerId])
  @@map("after_sales_cases")
}

enum AfterSalesType {
  REFUND // 退款退货
  EXCHANGE // 换货
  REPAIR // 维修
}

enum AfterSalesStatus {
  REQUESTED // 已申请
  APPROVED // 审核通过
  REJECTED // 已驳回
  RETURNING // 逆向物流中
  QC_PASSED // 质检通过
  QC_FAILED // 质检不通过
  COMPLETED // 已完成
  CANCELLED // 已取消
}

// ========== 购物车 ==========

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  sessionId String?  @map("session_id") @db.VarChar(100)
  skuId     Int      @map("sku_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku     ProductSKU @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([userId, createdAt]) // 复合索引
  @@map("carts")
}

// ========== 询价/咨询 ==========

model Inquiry {
  id                    Int       @id @default(autoincrement())
  productId             Int?      @map("product_id")
  customerId            Int?      @map("customer_id")
  customerName          String    @map("customer_name") @db.VarChar(50)
  customerPhone         String    @map("customer_phone") @db.VarChar(20)
  customerEmail         String?   @map("customer_email") @db.VarChar(100)
  consultationType      String?   @map("consultation_type") @db.VarChar(30)
  preferredContact      String?   @map("preferred_contact") @db.VarChar(20)
  preferredTime         String?   @map("preferred_time") @db.VarChar(20)
  budgetRange           String?   @map("budget_range") @db.VarChar(30)
  message               String    @db.Text
  privacyConsent        Boolean   @default(false) @map("privacy_consent")
  privacyConsentVersion String?   @map("privacy_consent_version") @db.VarChar(50)
  privacyConsentedAt    DateTime? @map("privacy_consented_at")
  status                String    @default("PENDING") @db.VarChar(20)
  assignedTo            Int?      @map("assigned_to")
  reply                 String?   @db.Text
  internalNote          String?   @map("internal_note") @db.Text
  nextFollowUpAt        DateTime? @map("next_follow_up_at")
  repliedAt             DateTime? @map("replied_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  product  Product?  @relation(fields: [productId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
