// ========== 商品访问审计（服务端可信日志）==========
// 推荐系统热度来源 + 合作商家访问审计。customerId 必须从已验证客户令牌派生，不接受客户端提交。
model ProductAccessLog {
  id         Int                    @id @default(autoincrement())
  customerId Int                    @map("customer_id")
  productId  Int                    @map("product_id")
