{
  // VS Code 任务（项目级）。
  // 约束：默认任务不得执行数据库迁移、数据库写入、部署或 Git 写入。
  // 所有任务在项目根目录运行。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "项目：类型检查",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "typecheck"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "项目：构建验证",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "数据库：Prisma Schema 校验",
      "type": "shell",
      "command": "npx.cmd",
      "args": ["prisma", "validate"],
      "options": { "cwd": "${workspaceFolder}/server" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "交易：状态机测试",
      "type": "shell",
      "command": "node",
      "args": ["scripts/verify-trade-state-machine.mjs"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "交易：库存与付款并发测试",
      "type": "shell",
      "command": "node",
      "args": ["scripts/verify-trade-concurrency.mjs"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "交易：关键链路静态契约测试",
      "type": "shell",
      "command": "node",
      "args": ["scripts/verify-trade-contract.mjs"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "开发：前后端联调",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
