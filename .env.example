# ============================================
# 海川珠宝 - 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ---- 数据库 (MySQL) ----
DATABASE_URL=mysql://jewelry_user:jewelry_pass_2024@localhost:3306/jewelry_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT 认证 ----
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# ---- 服务端口 ----
PORT=3000

# ---- 运行环境 ----
NODE_ENV=development

# ---- CORS 允许域名 (生产环境填写真实域名，多个用逗号分隔) ----
CORS_ORIGIN=http://localhost:5173

# ---- 阿里云 OSS (可选，文件上传) ----
# OSS_REGION=oss-cn-shenzhen
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=

# ---- Moonshot AI / Kimi (可选，AI分类) ----
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ---- 微信支付 (可选) ----
# WXPAY_APP_ID=
# WXPAY_MCH_ID=
# WXPAY_API_KEY=
# WXPAY_NOTIFY_URL=

# ---- 短信服务 (可选) ----
# SMS_ACCESS_KEY=
# SMS_SECRET_KEY=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
