# =====================================================
# 海川珠宝 · 环境变量模板
# 复制此文件为 .env 并填入真实值
# 详细说明见 docs/DEVELOPMENT_WORKFLOW.md
# =====================================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=请设置强密码
MYSQL_PASSWORD=请设置应用密码
DATABASE_URL=mysql://jewelry_user:请设置应用密码@mysql:3306/jewelry_db

# ---- 不可变发布制品 ----
# 正式发布必须使用 release-manifest.json 中的完整 digest 引用；不得填写浮动 tag。
# docker-compose.yml 不提供本地镜像或源码构建回退；任一值为空都会失败关闭。
SERVER_IMAGE_NAME=
SERVER_IMAGE_DIGEST=
CLIENT_IMAGE_NAME=
CLIENT_IMAGE_DIGEST=
# 一次性 migration 状态、只读发布预检和管理员初始化使用同一发布工作流构建的 operations digest。
OPERATIONS_IMAGE_NAME=
OPERATIONS_IMAGE_DIGEST=
# NAME 取 manifest.<component>.image；DIGEST 取 digest 去掉 sha256: 后的 64 位十六进制。
# Compose 字面拼接 @sha256:，无法回退成 tag；发布预检再核对它与 manifest 完全相同。
# 与镜像 OCI label、发布清单完全一致的 40 位 Git commit 与 migration bundle SHA-256。
RELEASE_GIT_SHA=
RELEASE_SOURCE=
MIGRATION_BUNDLE_SHA256=
# 发布前门禁档位：V1 固定 lead-generation；未来交易版必须显式使用 commerce。
RELEASE_PROFILE=lead-generation

# ---- 动态模板原子激活 ----
# 默认关闭；只读影响预检仍可用。仅在高风险门禁、目标数据库迁移、回滚和验收全部完成后显式设为 true。

# ---- JWT 认证 ----
JWT_SECRET=请生成随机字符串至少32位

# ---- 微信开放平台扫码登录（可选，未配置则前端自动隐藏扫码入口）----
# 需先在微信开放平台（open.weixin.qq.com）完成企业认证并创建「网站应用」，
# 回调域名必须已 ICP 备案。三个变量全部填写后扫码登录才会启用。
# WECHAT_APP_ID=你的网站应用AppID
# WECHAT_APP_SECRET=你的网站应用AppSecret
# WECHAT_REDIRECT_URI=https://你的域名/api/customers/wechat/callback

# ---- 缓存（Redis）----
# Redis 已移除（OR 批决策）：queue 删除后服务端零消费方。
# 未来启用缓存/共享限流时，必须同时恢复服务、运行时消费方和配置合同。

# ---- 跨域 ----
# 生产必填：填写已确认的正式前端来源。多个来源用逗号分隔。
# 只能包含 scheme + host + 可选端口，不含路径、查询参数或尾随斜杠；缺失或非法时生产服务会拒绝启动。
CORS_ORIGIN=https://正式前端域名

# ---- 线上交易开关 ----
# 默认 false；获 D.2 批准后显式 true 才开放购物车/结算/线下转账付款（后端守卫兜底 503）
CUSTOMER_COMMERCE_ENABLED=false

# ---- 合作申请写能力 ----
# 默认关闭；协议法务终审、客服责任人、处理 SLA、通知与失败补偿全部验收后才可显式开启。
# 关闭时仍允许已登录客户查看既有申请状态，后台仍可只读查看历史记录。
PARTNER_APPLICATIONS_WRITE_ENABLED=false

# ---- 本地 Demo Seed（生产禁止）----
# 默认关闭；仅对明确的本地开发库执行 `prisma db seed` 时临时设为 true。
# Demo Seed 会创建固定演示管理员、仓库、分类和 5 条演示商品，绝不能用于候选或生产库。
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=

# ---- 首管理员一次性初始化（不要注入长期运行的 server service）----
# 仅在空的候选/生产数据库完成 migration 后，通过一次性 CLI 进程临时提供；执行后立即清除。
# 用户名必须为非通用名称；密码遵循当前后台账号合同：长度 12–64 位。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# 可选；不提供时账号姓名保持为空，后续由本人登录后维护。
BOOTSTRAP_ADMIN_REAL_NAME=

# ---- 正式发布前目标环境审计（仅一次性 CLI，不注入长期运行 server）----
# 即使只读也必须显式授权，并使用只具备目标数据库 USAGE/SELECT/SHOW VIEW 的账号。
RELEASE_PREFLIGHT_READ_ONLY_AUTHORIZED=0
# 环境名、预期数据库和审批引用必须来自本次目标环境负责人；报告只保存审批引用哈希。
RELEASE_PREFLIGHT_ENVIRONMENT_ID=
RELEASE_PREFLIGHT_EXPECTED_DATABASE=
RELEASE_PREFLIGHT_APPROVAL_REFERENCE=
# 上述一次性 runner 必须使用单独的最小权限连接串，不得复用长期服务账号。
RELEASE_PREFLIGHT_DATABASE_URL=
# migration status runner 的连接串；执行 migrate deploy 仍需单次审批与单独写权限凭据。
OPERATIONS_DATABASE_URL=
# 首管理员初始化使用的一次性最小写权限连接串；不得注入长期 server service。
BOOTSTRAP_DATABASE_URL=

# ---- PageDocument 发布指针目标审计 / 回填（仅一次性 CLI，不注入长期运行 server）----
# dry-run 也必须显式确认只读审计，并使用仅有 USAGE/SELECT/SHOW VIEW 的数据库账号。
PAGE_PUBLISHED_REVISION_AUDIT_READ_ONLY_AUTHORIZED=0
# 环境名、预期数据库和审批引用必须由本次目标环境负责人提供；报告只保存审批引用哈希。
PAGE_PUBLISHED_REVISION_ENVIRONMENT_ID=
PAGE_PUBLISHED_REVISION_EXPECTED_DATABASE=
PAGE_PUBLISHED_REVISION_APPROVAL_REFERENCE=
# apply 还必须同时传入 --apply；默认值 0 永不授权写入。
PAGE_PUBLISHED_REVISION_BACKFILL_APPLY=0

# ---- 前端开发 ----
# 默认 `npm run dev` 使用真实 API；离线界面开发使用 `npm run dev:mock`。
VITE_API_BASE_URL=/api
# 正式公开站点 Origin：仅 scheme + host + 可选端口，不含路径、查询或尾随内容。
# 未确认正式域名前保持注释；配置后用于 canonical / og:url，生产只接受 HTTPS。
# VITE_PUBLIC_SITE_ORIGIN=https://www.example.com
# 前端分析构建开关：默认关闭；即使开启也必须等待访客明确同意。
VITE_ANALYTICS_ENABLED=false
# 服务端分析入库开关：默认关闭；只接受带明确同意声明的白名单事件。
ANALYTICS_INGESTION_ENABLED=false
# 分析数据集默认隔离为 test；生产启用入库时必须显式改为 production。
ANALYTICS_DATASET=test
# 分析事件保留天数（1-365）；自动清理仍需显式开启。
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_RETENTION_ENABLED=false
# 仅当源站已限制为可信 Cloudflare 边缘流量，并启用访客地域请求头时设为 true。
# 服务端只读取国家、省/地区、城市，不保存原始 IP、经纬度或邮编。
ANALYTICS_TRUSTED_GEO_HEADERS=false
# 分析后台展示开关；仅影响后台可见性，不会开启前台埋点或入库。
ANALYTICS_DASHBOARD_ENABLED=true

# ---- AI 服务（可选）----
# 当前只接入 Kimi；未配置时 AI 分类能力诚实降级。
# KIMI_API_KEY=你的Kimi API Key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3

# ---- 金价 API（可选）----
# GOLD_PRICE_API_URL=https://api.example.com/gold-price

# ---- 媒体路径 ----
# 容器内 PRODUCT_MEDIA_ROOT 由 docker-compose.yml 固定为持久化私有媒体卷。
# 已归档原图不挂载到生产容器；宿主机开发沿用代码内安全默认值。
# 生产必须填写已核对的现有卷名；Compose 不会静默创建空数据库或空媒体卷。
MYSQL_VOLUME_NAME=
UPLOADS_VOLUME_NAME=
PRIVATE_MEDIA_VOLUME_NAME=

# ---- 备份、恢复目标与资源预算（生产 Compose 必填）----
# 以下数值必须由环境负责人确认；模板不替业务方预设 RPO/RTO。
BACKUP_DB_READY_TIMEOUT_SECONDS=
BACKUP_INTERVAL_SECONDS=
# 最大可接受数据丢失窗口；备份周期必须小于等于该值，超龄即容器不健康。
BACKUP_RPO_SECONDS=
# 定时备份默认 best-effort；发布回滚点只有在写入已静默并保存证据哈希时才设为 quiesced。
BACKUP_CONSISTENCY_MODE=best-effort
BACKUP_WRITE_QUIESCE_EVIDENCE_SHA256=NONE
# 最大可接受恢复时长；恢复演练脚本据此判定是否达标。
RESTORE_RTO_SECONDS=
BACKUP_RETENTION_DAYS=
# 必须为宿主机绝对路径；生产 Compose 不再依赖当前工作目录解析 ./backups。
BACKUP_HOST_DIR=

# ---- 隔离恢复演练（仅一次性 runner）----
RESTORE_DRILL_AUTHORIZED=0
RESTORE_DRILL_ENVIRONMENT_ID=
RESTORE_DRILL_APPROVAL_REFERENCE=
RESTORE_DRILL_EXPECTED_DATABASE=
RESTORE_DRILL_TARGET_CLASS=isolated-empty
RESTORE_DRILL_CONFIRM=
RESTORE_DRILL_ISOLATION_EVIDENCE_SHA256=
RESTORE_DRILL_ROOT=
RESTORE_MANIFEST=
RESTORE_EVIDENCE_DIR=
MEDIA_TARGET_DIRS=
# 备份目标磁盘使用率告警阈值（%）。
DISK_WARN_PCT=85
# server 容器内备份产物目录（compose 已将宿主 ./backups 只读挂载到 /backups），
# 后台"系统设置"据此展示真实备份状态；仅本地非容器开发时可覆盖
# BACKUP_DIR=/backups

# 默认资源上限可按容量评估调整；不得删除上限后上线。
MYSQL_CPUS=2.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_PIDS_LIMIT=512
SERVER_CPUS=1.5
SERVER_MEMORY_LIMIT=1g
SERVER_PIDS_LIMIT=256
CLIENT_CPUS=1.0
CLIENT_MEMORY_LIMIT=384m
CLIENT_PIDS_LIMIT=128
BACKUP_CPUS=1.0
BACKUP_MEMORY_LIMIT=768m
BACKUP_PIDS_LIMIT=128
MONITOR_CPUS=0.5
MONITOR_MEMORY_LIMIT=512m
MONITOR_PIDS_LIMIT=256
OPERATIONS_CPUS=1.0
OPERATIONS_MEMORY_LIMIT=768m
OPERATIONS_PIDS_LIMIT=128

# ---- 邮件通知（可选，未配置则所有邮件通知诚实降级为服务端日志）----
# 任何 SMTP 服务商均可（企业邮箱/QQ邮箱/阿里云邮件推送等），填入后自动生效：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=发件账号@example.com
# SMTP_PASS=发件账号密码或授权码
# SMTP_FROM="海川珠宝" <noreply@example.com>   # 可选，缺省用 SMTP_USER
# 站点前台地址（邮件内链接用，如密码重置链接），默认 http://localhost:5173
# SITE_BASE_URL=https://正式域名
# 可靠通知外部投递消费者：默认关闭。只在目标库已具备通知/Outbox 表、SMTP 与测试收件人均验收后开启。
NOTIFICATION_DELIVERY_ENABLED=false

# ---- 线索到期隐私处置（仅一次性 CLI，不注入长期运行 server）----
# 默认命令只做零写入预览；真实执行还必须同时提供 --execute、固定确认词和启用中的 SUPER_ADMIN ID。
LEAD_RETENTION_DISPOSITION_ENABLED=false
LEAD_RETENTION_DISPOSITION_ACTOR_ID=

# ---- 在线支付（可选，交易解冻时接入；未配置则在线收款通道自动隐藏）----
# 服务端真实资金交易总开关：默认关闭；只控制新建网关交易，不关闭既有有效支付回调验签与核销。
PAYMENT_GATEWAY_TRANSACTIONS_ENABLED=false
# 服务端真实原路退款独立开关：默认关闭；只阻止发起新退款，不阻断既有退款查询与验签通知。
PAYMENT_GATEWAY_REFUNDS_ENABLED=false
# 支付宝·当面付（扫码）：签约当面付产品后在开放平台获取
# ALIPAY_APP_ID=应用APPID
# ALIPAY_PRIVATE_KEY=应用私钥（不含头尾行的 PEM 内容）
# ALIPAY_PUBLIC_KEY=支付宝公钥（用于回调验签，非应用公钥）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do   # 可选，沙箱联调改沙箱网关
# 微信支付·Native（扫码）：商户平台获取。基础 Compose 不挂载证书，真实支付保持不可用。
# 注意：WECHAT_PAY_APP_ID 是商户号绑定的公众号/小程序 AppID，与上方扫码登录的
# WECHAT_APP_ID（开放平台网站应用）通常不是同一个值，请分别填写。
# WECHAT_PAY_APP_ID=支付绑定的AppID
# WECHAT_MCH_ID=商户号
# WECHAT_MCH_CERT_SERIAL_NO=商户API证书序列号（不是微信支付平台证书序列号）
# 仅直接在宿主机运行 server 时填写服务端可读路径；容器内路径由显式 override 固定，不得改为宿主路径。
# WECHAT_PLATFORM_CERT_PATH=/受控路径/wechat_platform_cert.pem
# WECHAT_MCH_PRIVATE_KEY_PATH=/受控路径/wechat_mch_private_key.pem
# 仅在显式叠加 docker-compose.wechat-pay.yml 时填写；必须是两个不同的宿主绝对文件路径。
# override 使用只读 bind 且 create_host_path:false，不会为缺失路径创建空目录。
WECHAT_PLATFORM_CERT_HOST_PATH=
WECHAT_MCH_PRIVATE_KEY_HOST_PATH=
# WECHAT_API_V3_KEY=APIv3密钥（回调报文解密+验签）

# ---- 物流轨迹查询（可选，快递100；未配置则客户侧轨迹查询诚实返回 503）----
# 快递100 企业版/实时查询：注册 kuaidi100.com → 实时快递查询产品获取
# KUAIDI100_CUSTOMER=你的customer
# KUAIDI100_KEY=你的授权key

# ---- 短信验证码（可选，阿里云短信；未配置则发码接口诚实 503，注册流程不受影响）----
# 阿里云控制台开通短信服务 → 申请签名与模板（模板变量用 ${code}）
# ALIYUN_SMS_ACCESS_KEY_ID=你的AccessKeyId（建议独立于OSS的子账号密钥）
# ALIYUN_SMS_ACCESS_KEY_SECRET=你的AccessKeySecret
# ALIYUN_SMS_SIGN_NAME=你的短信签名
# ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXX
# 注册是否强制短信验证码（默认 false；凭据接入并实测发码成功后再改为 true）
# SMS_VERIFICATION_REQUIRED=false
