# =====================================================
# 海川珠宝 · 环境变量模板
# 复制此文件为 .env 并填入真实值
# 详细说明见 docs/DEVELOPMENT_WORKFLOW.md
# =====================================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=请设置强密码
MYSQL_PASSWORD=请设置应用密码
DATABASE_URL=mysql://jewelry_user:请设置应用密码@mysql:3306/jewelry_db

# ---- JWT 认证 ----
JWT_SECRET=请生成随机字符串至少32位
JWT_EXPIRES_IN=7d

# ---- 跨域 ----
CORS_ORIGIN=https://你的域名

# ---- 管理员初始化 ----
BOOTSTRAP_ADMIN_PASSWORD=请设置管理员初始密码

# ---- 前端开发 ----
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=请设置Mock管理员密码

# ---- 阿里云 OSS（可选）----
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=你的AccessKey
# OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
# OSS_BUCKET=你的Bucket名
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---- AI 服务（可选）----
# AI_ACCESS_KEY_ID=你的AI AccessKey
# AI_ACCESS_KEY_SECRET=你的AI AccessKeySecret
# KIMI_API_KEY=你的Kimi API Key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3

# ---- 金价 API（可选）----
# GOLD_PRICE_API_URL=https://api.example.com/gold-price

# ---- 上传路径 ----
UPLOAD_DIR=./uploads
