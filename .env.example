# =====================================================
# 海川珠宝 · 环境变量模板
# 复制此文件为 .env 并填入真实值
# 详细说明见 docs/DEVELOPMENT_WORKFLOW.md
# =====================================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=请设置强密码
MYSQL_PASSWORD=请设置应用密码
DATABASE_URL=mysql://jewelry_user:请设置应用密码@mysql:3306/jewelry_db

# ---- JWT 认证 ----
JWT_SECRET=请生成随机字符串至少32位
JWT_EXPIRES_IN=7d

# ---- 微信开放平台扫码登录（可选，未配置则前端自动隐藏扫码入口）----
# 需先在微信开放平台（open.weixin.qq.com）完成企业认证并创建「网站应用」，
# 回调域名必须已 ICP 备案。三个变量全部填写后扫码登录才会启用。
# WECHAT_APP_ID=你的网站应用AppID
# WECHAT_APP_SECRET=你的网站应用AppSecret
# WECHAT_REDIRECT_URI=https://你的域名/api/customers/wechat/callback

# ---- 缓存（Redis）----
# Redis 已移除（OR 批决策）：queue 删除后服务端零消费方。
# 未来启用缓存/共享限流时，恢复 docker-compose redis 服务与此处的 REDIS_PASSWORD。
# REDIS_PASSWORD=请设置Redis强密码

# ---- 跨域 ----
# 生产必填：填写已确认的正式前端来源。多个来源用逗号分隔。
# 只能包含 scheme + host + 可选端口，不含路径、查询参数或尾随斜杠；缺失或非法时生产服务会拒绝启动。
CORS_ORIGIN=https://正式前端域名

# ---- 线上交易开关 ----
# 默认 false；获 D.2 批准后显式 true 才开放购物车/结算/线下转账付款（后端守卫兜底 503）
CUSTOMER_COMMERCE_ENABLED=false

# ---- 管理员初始化 ----
BOOTSTRAP_ADMIN_PASSWORD=请设置管理员初始密码

# ---- 前端开发 ----
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
VITE_MOCK_ADMIN_USERNAME=admin
VITE_MOCK_ADMIN_PASSWORD=请设置Mock管理员密码

# ---- 阿里云 OSS（可选）----
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=你的AccessKey
# OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
# OSS_BUCKET=你的Bucket名
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---- AI 服务（可选）----
# AI_ACCESS_KEY_ID=你的AI AccessKey
# AI_ACCESS_KEY_SECRET=你的AI AccessKeySecret
# KIMI_API_KEY=你的Kimi API Key
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k3

# ---- 金价 API（可选）----
# GOLD_PRICE_API_URL=https://api.example.com/gold-price

# ---- 上传路径 ----
UPLOAD_DIR=./uploads

# ---- 备份（可选，docker-compose backup 服务读取；均有默认值）----
# 备份执行周期（秒），默认 86400 = 每日一轮
# BACKUP_INTERVAL_SECONDS=86400
# 备份目标磁盘使用率告警阈值（%），默认 85
# DISK_WARN_PCT=85
# server 容器内备份产物目录（compose 已将宿主 ./backups 只读挂载到 /backups），
# 后台"系统设置"据此展示真实备份状态；仅本地非容器开发时可覆盖
# BACKUP_DIR=/backups

# ---- 邮件通知（可选，未配置则所有邮件通知诚实降级为服务端日志）----
# 任何 SMTP 服务商均可（企业邮箱/QQ邮箱/阿里云邮件推送等），填入后自动生效：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=发件账号@example.com
# SMTP_PASS=发件账号密码或授权码
# SMTP_FROM="海川珠宝" <noreply@example.com>   # 可选，缺省用 SMTP_USER
# 站点前台地址（邮件内链接用，如密码重置链接），默认 http://localhost:5173
# SITE_BASE_URL=https://正式域名

# ---- 在线支付（可选，交易解冻时接入；未配置则在线收款通道自动隐藏）----
# 服务端真实资金交易总开关：默认关闭；只控制新建网关交易，不关闭既有有效支付回调验签与核销。
PAYMENT_GATEWAY_TRANSACTIONS_ENABLED=false
# 支付宝·当面付（扫码）：签约当面付产品后在开放平台获取
# ALIPAY_APP_ID=应用APPID
# ALIPAY_PRIVATE_KEY=应用私钥（不含头尾行的 PEM 内容）
# ALIPAY_PUBLIC_KEY=支付宝公钥（用于回调验签，非应用公钥）
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do   # 可选，沙箱联调改沙箱网关
# 微信支付·Native（扫码）：商户平台获取，证书/私钥为文件路径
# 注意：WECHAT_PAY_APP_ID 是商户号绑定的公众号/小程序 AppID，与上方扫码登录的
# WECHAT_APP_ID（开放平台网站应用）通常不是同一个值，请分别填写。
# WECHAT_PAY_APP_ID=支付绑定的AppID
# WECHAT_MCH_ID=商户号
# WECHAT_PLATFORM_CERT_PATH=./certs/wechat_platform_cert.pem   # 微信支付平台证书路径
# WECHAT_MCH_PRIVATE_KEY_PATH=./certs/wechat_mch_private_key.pem  # 商户API私钥路径
# WECHAT_API_V3_KEY=APIv3密钥（回调报文解密+验签）

# ---- 物流轨迹查询（可选，快递100；未配置则客户侧轨迹查询诚实返回 503）----
# 快递100 企业版/实时查询：注册 kuaidi100.com → 实时快递查询产品获取
# KUAIDI100_CUSTOMER=你的customer
# KUAIDI100_KEY=你的授权key

# ---- 短信验证码（可选，阿里云短信；未配置则发码接口诚实 503，注册流程不受影响）----
# 阿里云控制台开通短信服务 → 申请签名与模板（模板变量用 ${code}）
# ALIYUN_SMS_ACCESS_KEY_ID=你的AccessKeyId（建议独立于OSS的子账号密钥）
# ALIYUN_SMS_ACCESS_KEY_SECRET=你的AccessKeySecret
# ALIYUN_SMS_SIGN_NAME=你的短信签名
# ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXX
# 注册是否强制短信验证码（默认 false；凭据接入并实测发码成功后再改为 true）
# SMS_VERIFICATION_REQUIRED=false
